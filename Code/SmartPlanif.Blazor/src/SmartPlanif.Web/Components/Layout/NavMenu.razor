@code {
    private bool _expanded = true;

    private void ToggleSidebar()
    {
        _expanded = !_expanded;
    }
}

<aside class="sidebar @(_expanded ? "expanded" : "collapsed")">
    <div class="brand">
        <!-- Logo SVG chargé depuis un fichier -->
        @* <img src="images/logo.svg"  *@
        @*      class="brand-logo"  *@
        @*      alt="SmartPlanif"  *@
        @*      title="@(_expanded ? "" : "SmartPlanif")" /> *@
        <!-- Logo : cliquable UNIQUEMENT en mode réduit pour ré-ouvrir la sidebar -->
        <img src="images/logo.svg"
             class="brand-logo @(_expanded ? "" : "clickable")"
             alt="SmartPlanif"
             title="@(_expanded ? "" : "Agrandir le menu")"
             @onclick="@(() => { if (!_expanded) ToggleSidebar(); })" />
        @if (_expanded)
        {
            <span class="brand-text">SmartPlanif</span>
            <!-- Bouton hamburger : visible UNIQUEMENT en mode étendu -->
            <button class="toggle-btn" @onclick="ToggleSidebar" title="Réduire le menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="15" y2="12"></line>
                    <line x1="3" y1="18" x2="18" y2="18"></line>
                </svg>
            </button>
        }
        @* <button class="toggle-btn" @onclick="ToggleSidebar" title="@(_expanded ? "Réduire le menu" : "Agrandir le menu")"> *@
        @*     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> *@
        @*         @if (_expanded) *@
        @*         { *@
        @*             <line x1="3" y1="6" x2="21" y2="6"></line> *@
        @*             <line x1="3" y1="12" x2="15" y2="12"></line> *@
        @*             <line x1="3" y1="18" x2="18" y2="18"></line> *@
        @*         } *@
        @*         else *@
        @*         { *@
        @*             <line x1="3" y1="6" x2="21" y2="6"></line> *@
        @*             <line x1="3" y1="12" x2="21" y2="12"></line> *@
        @*             <line x1="3" y1="18" x2="21" y2="18"></line> *@
        @*         } *@
        @*     </svg> *@
        @* </button> *@
    </div>

    <nav>
        <NavLink href="" Match="NavLinkMatch.All" class="nav-tooltip" data-tooltip="Vue d'ensemble et tableau de bord">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            @if (_expanded)
            {
                <span>Accueil</span>
            }
        </NavLink>
        
        <NavLink href="kpis" class="nav-tooltip" data-tooltip="Mesure de la performance et indicateurs clés">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 0 0-10 10"></path>
                <path d="M12 2a10 10 0 0 1 10 10"></path>
                <path d="M12 12l-4-4"></path>
                <circle cx="12" cy="12" r="1"></circle>
            </svg>
            @if (_expanded)
            {
                <span>Performance</span>
            }
        </NavLink>
        @* <NavLink href="kpis" class="nav-tooltip" data-tooltip="Mesure de la performance et indicateurs clés"> *@
        @*     <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> *@
        @*         <line x1="18" y1="20" x2="18" y2="10"></line> *@
        @*         <line x1="12" y1="20" x2="12" y2="4"></line> *@
        @*         <line x1="6" y1="20" x2="6" y2="14"></line> *@
        @*         <polyline points="3 17 9 11 13 15 21 7"></polyline> *@
        @*     </svg> *@
        @*     @if (_expanded) { <span>Performance</span> } *@
        @* </NavLink> *@
        @* <NavLink href="kpis" class="nav-tooltip" data-tooltip="Mesure de la performance et indicateurs clés"> *@
        @*     <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> *@
        @*         <circle cx="12" cy="12" r="10"></circle> *@
        @*         <circle cx="12" cy="12" r="6"></circle> *@
        @*         <circle cx="12" cy="12" r="2"></circle> *@
        @*     </svg> *@
        @*     @if (_expanded) { <span>Performance</span> } *@
        @* </NavLink>        *@
        <NavLink href="constraints" class="nav-tooltip" data-tooltip="Définir les règles et limites de planification">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            @if (_expanded)
            {
                <span>Contraintes</span>
            }
        </NavLink>

        <NavLink href="line-types" class="nav-tooltip" data-tooltip="Configurer les caractéristiques des lignes">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            @if (_expanded)
            {
                <span>Types de ligne</span>
            }
        </NavLink>

        <NavLink href="parameters" class="nav-tooltip" data-tooltip="Ajuster les réglages globaux de l'application">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            @if (_expanded)
            {
                <span>Paramètres</span>
            }
        </NavLink>

        <NavLink href="diagnostics" class="nav-tooltip" data-tooltip="Analyser les erreurs et vérifier la faisabilité">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            @if (_expanded)
            {
                <span>Diagnostic</span>
            }
        </NavLink>

        <NavLink href="allocation" class="nav-tooltip" data-tooltip="Générer et assigner le planning des ressources">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            @if (_expanded)
            {
                <span>Allocation</span>
            }
        </NavLink>

        <NavLink href="reassignment" class="nav-tooltip" data-tooltip="Réaffecter les voyages après un aléa (panne, absence)">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 4v6h6"></path>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            @if (_expanded)
            {
                <span>Réaffectation</span>
            }
        </NavLink>

        <NavLink href="saved-plan" class="nav-tooltip" data-tooltip="Consulter et gérer l'historique des plannings">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            @if (_expanded)
            {
                <span>Plan enregistré</span>
            }
        </NavLink>

        <NavLink href="agents" class="nav-tooltip" data-tooltip="Consulter et gérer la liste d'agents">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            @if (_expanded)
            {
                <span>Agents</span>
            }
        </NavLink>

        <NavLink href="buses" class="nav-tooltip" data-tooltip="Consulter et gérer la liste des bus">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 6v6"></path>
                <path d="M15 6v6"></path>
                <path d="M2 12h19.6"></path>
                <path d="M18 18h2a1 1 0 0 0 1-1v-3.65l-2.22-6.66A2 2 0 0 0 16.88 5H5.12a2 2 0 0 0-1.9 1.37L1 13.35V17a1 1 0 0 0 1 1h2"></path>
                <circle cx="6.5" cy="17.5" r="1.5"></circle>
                <circle cx="15.5" cy="17.5" r="1.5"></circle>
            </svg>
            @if (_expanded)
            {
                <span>Bus</span>
            }
        </NavLink>
        <NavLink href="lines" class="nav-tooltip" data-tooltip="Consulter les lignes, leurs itinéraires et leurs voyages">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="19" r="3"></circle>
                <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
                <circle cx="18" cy="5" r="3"></circle>
            </svg>
            @if (_expanded)
            {
                <span>Lignes</span>
            }
        </NavLink>
    </nav>
</aside>