    private static string CritCss(double v) => v >= 0.75 ? "good" : v >= 0.4 ? "mid" : "low";

    private RenderFragment RenderDecision(ResourceDecision d) => __builder =>
    {
        <section class="why-card">
            <h3>
                @d.Role : <span class="why-chosen">@d.ChosenLabel</span>
                <span class="badge soft">@Number(d.Score) / @Number(d.MaxScore) pts</span>
                <span class="badge @(d.Rank == 1 ? "soft" : "off")">rang @d.Rank / @d.EligibleCount</span>
            </h3>
            <p class="why-summary">@d.Summary</p>

            @foreach (var c in d.Criteria)
            {
                <div class="crit-row">
                    <span class="crit-name" title="@c.Code">@c.Name</span>
                    <div class="crit-bar"><div class="crit-fill @CritCss(c.Value)" style="width:@Percent(c.Value, 1)%"></div></div>
                    <span class="crit-pts">@Number(c.Points) / @Number(c.Weight)</span>
                    @if (c.Note is not null)
                    {
                        <div class="crit-note muted small">@c.Note</div>
                    }
                </div>
            }

            <p class="muted small">
                Charge ce jour-là (hors ce voyage) : <strong>@Number(d.ChosenHours) h</strong>
                — moyenne des candidats : <strong>@Number(d.AverageHours) h</strong>
            </p>

            @if (d.Alternatives.Count > 0)
            {
                <table class="grid">
                    <thead><tr><th>Alternative</th><th>Score</th><th>Écart</th><th>Ce qui la désavantage</th></tr></thead>
                    <tbody>
                        @foreach (var alt in d.Alternatives)
                        {
                            <tr>
                                <td>@alt.Label</td>
                                <td>@Number(alt.Score)</td>
                                <td>@(alt.Gap >= 0 ? "−" : "+")@Number(Math.Abs(alt.Gap))</td>
                                <td class="small">
                                    @string.Join(" ; ", alt.Deltas.Select(x =>
                                    $"{x.Name} ({(x.Delta >= 0 ? "+" : "")}{Number(x.Delta)}{(x.OtherNote is null ? "" : " : " + x.OtherNote)})"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (d.Rejections.Count > 0)
            {
                <details>
                    <summary>@d.RejectedCount éliminé(s) par une règle dure</summary>
                    <ul class="small">
                        @foreach (var r in d.Rejections)
                        {
                            <li><strong>@r.Name</strong> × @r.Count — @string.Join(", ", r.Examples)@(r.Count > r.Examples.Count ? "…" : "")</li>
                        }
                    </ul>
                </details>
            }
        </section>
    };
