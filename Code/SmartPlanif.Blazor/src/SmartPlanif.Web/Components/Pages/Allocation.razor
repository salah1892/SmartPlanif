@page "/allocation"
@using System.Globalization
@inject AllocateDayHandler AllocateHandler
@inject PreviewDayHandler PreviewHandler
@inject PlanningCalendar Calendar
@inject IReferenceDataRepository Reference
@inject LineQueryService LineService
@using System.Text.RegularExpressions


<PageTitle>Allocation</PageTitle>

<h1>Allocation d'une journée</h1>

<p class="muted">
    Planification à partir d'<strong>aujourd'hui</strong> (@Calendar.Today.ToString("dd/MM/yyyy")). Les journées passées sont consultables
    mais <strong>grisées</strong> : elles ne sont ni planifiables ni modifiables.
</p>

<div class="panel @(IsPast ? "past" : "")">
    <div class="form-grid compact">
        <label>
            Date (à partir du @Calendar.Today.ToString("dd/MM/yyyy"))
            <input type="date" @bind="_dateInput" min="@Calendar.Today.ToString("yyyy-MM-dd")" disabled="@_running" />
        </label>
        <label>
            Méthode
            <select @bind="_method" disabled="@(_running || IsPast)">
                @foreach (var method in Enum.GetValues<AllocationMethod>())
                {
                    <option value="@method">@MethodLabel(method)</option>
                }
            </select>
        </label>
        @* <label>Utilisateur
            <input type="text" @bind="_user" disabled="@(_running || IsPast)" /></label> *@
        <label>
            Voyages déjà planifiés
            <select @bind="_existingMode" disabled="@(_running || IsPast)">
                <option value="@ExistingPlanMode.FillMissingOnly">Compléter : garder les plans existants</option>
                <option value="@ExistingPlanMode.ReplaceDay">Remplacer : replanifier toute la journée</option>
            </select>
        </label>
        <label>
            Enregistrement dans la table trips
            <select @bind="_saveMode" disabled="@(_running || IsPast)">
                <option value="@SaveMode.None">Aucun (simulation)</option>
                <option value="@SaveMode.CompleteDayOnly">Journée complète seulement</option>
                <option value="@SaveMode.AllowPartial">Même si la journée est incomplète</option>
            </select>
        </label>
    </div>
    <div class="toolbar">
        <button class="btn" @onclick="PreviewAsync" disabled="@_running">Analyser la faisabilité</button>
        <button class="btn primary" @onclick="RunAsync" disabled="@(_running || IsPast)">Lancer l'allocation</button>
        <button class="icon-btn help" title="Aide : l'allocation expliquée en phrases courtes (clic)"
                @onclick="() => _showHelp = !_showHelp" aria-label="Aide allocation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
        </button>
        @if (_running)
        {
            <button class="btn danger" @onclick="Cancel">Arrêter</button>
        }
    </div>
    @if (_showHelp)
    {
        <div class="alert warn help-panel">
            <strong>L'allocation en phrases courtes :</strong>
            <ul>
                <li>Chaque voyage reçoit <strong>un bus + un chauffeur + un receveur</strong> (deux personnes différentes).</li>
                <li><strong>Règles dures</strong> = éliminatoires (chevauchement, repos, heures max…) : aucun score ne les compense.</li>
                <li><strong>Règles souples</strong> = points de préférence (même centre, peu d'heures, continuité…) : elles départagent les ressources valides.</li>
                <li><strong>Méthode 3 (recommandée)</strong> : construction par phases (types de ligne tendus d'abord), puis amélioration ALNS + recuit simulé.</li>
                <li><strong>« Compléter »</strong> garde les plans déjà enregistrés ; <strong>« Remplacer »</strong> replanifie tout, sauf les voyages déjà effectués.</li>
                <li><strong>Enregistrement</strong> : « Aucun » = simulation (rien n'est écrit dans trips) ; les autres modes écrivent BUS_PR / CHAUFF_PR / REC_PR.</li>
                <li><strong>Objectif</strong> : plus petit = meilleur (voyages non affectés fortement pénalisés, puis score, puis équité de charge).</li>
                <li><strong>Contrôle indépendant</strong> : rejoue les règles dures sur le plan final ; un plan invalide n'est jamais enregistré.</li>
                <li>Icône <strong>?</strong> sur une ligne du plan : <strong>survol</strong> = pourquoi ce score ; <strong>clic</strong> = détail complet.</li>
            </ul>
        </div>
    }
</div>

@if (IsPast)
{
    <div class="alert warn">
        🔒 Le @SelectedDate.ToString("dd/MM/yyyy") est une journée passée : elle n'est pas éligible à la planification.
        Choisissez une date à partir du @Calendar.Today.ToString("dd/MM/yyyy"). Vous pouvez toujours consulter son plan dans « Plan enregistré ».
    </div>
}

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

@if (_running)
{
    <div class="alert warn">
        Calcul en cours…
        @if (_progress is not null)
        {
            <span>
                itération @_progress.Iteration — meilleur objectif @_progress.BestObjective.ToString("0.#", CultureInfo.InvariantCulture)
                — voyages non affectés : @_progress.UnassignedInBest — @_progress.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s
            </span>
        }
    </div>
}

@if (_preview is not null)
{
    <h2>Aperçu de la journée du @_preview.Date.ToString("dd/MM/yyyy")</h2>
    <p>
        <strong>@_preview.DayTrips</strong> voyages ce jour-là : <strong>@_preview.TripsToAllocate</strong> à planifier,
        @_preview.AlreadyPlannedInDay avec un plan prévu déjà enregistré, @_preview.RealizedInDay déjà effectués (ressources réelles, jamais modifiés).
        @_preview.LockedTrips voyage(s) verrouillé(s) bloquent leurs ressources.
        @_preview.ActiveBuses bus actifs, @_preview.Drivers agents aptes au poste de chauffeur, @_preview.Receivers aptes au poste de receveur (chaque voyage en exige deux, différents).
        Répartition à planifier : @string.Join(", ", _preview.LineTypes.Select(t => $"{t.Label} : {t.TripCount}"))
    </p>
    @RenderFeasibility(_preview.Feasibility)
}

@if (_report is not null)
{
    <h2>Résultat — @MethodLabel(_report.Method)</h2>

    <div class="kpis">
        <div class="kpi @(_report.UnassignedCount == 0 ? "good" : "bad")">
            <span class="value">@_report.AssignedCount / @_report.TotalTrips</span><span>voyages affectés</span>
        </div>
        <div class="kpi @(_report.UnassignedCount == 0 ? "good" : "bad")">
            <span class="value">@_report.UnassignedCount</span><span>non affectés</span>
        </div>
        <div class="kpi">
            <span class="value">@Number(_report.ConstructionObjective) → @Number(_report.FinalObjective)</span><span>objectif (construction → final)</span>
        </div>
        <div class="kpi">
            <span class="value">@_report.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s</span><span>temps de calcul</span>
        </div>
        <div class="kpi @(_report.Violations.Count == 0 ? "good" : "bad")">
            <span class="value">@(_report.Violations.Count == 0 ? "Valide" : _report.Violations.Count + " violation(s)")</span><span>contrôle indépendant</span>
        </div>
    </div>

    @if (_report.Save is not null)
    {
        <div class="alert @(_report.Save.Success ? "ok" : "error")">@_report.Save.Message</div>
    }
    else if (_saveMode == SaveMode.None)
    {
        <div class="alert warn">Simulation : rien n'a été écrit dans la table trips.</div>
    }

    <h3>Contraintes appliquées</h3>
    <p>
        Dures :
        @foreach (var constraintCode in _report.HardConstraintCodes)
        {
            <span class="badge hard" title="@ConstraintCatalog.DescribeCode(constraintCode)">@constraintCode</span>
        }
    </p>
    <p>
        Souples :
        @foreach (var constraintCode in _report.SoftConstraintCodes)
        {
            <span class="badge soft" title="@ConstraintCatalog.DescribeCode(constraintCode)">@constraintCode</span>
        }
    </p>

    @if (_report.Violations.Count > 0)
    {
        <div class="alert error">
            <strong>Le contrôle indépendant a détecté des violations de règles dures (bug probable) :</strong>
            <ul>
                @foreach (var violation in _report.Violations.Take(20))
                {
                    <li>Voyage @violation.TripId — @violation.Resource — @ConstraintCatalog.DescribeCode(violation.Code) : @violation.Message</li>
                }
            </ul>
        </div>
    }

    @if (_report.Phases.Count > 0)
    {
        <h3>Phases de construction (du type de ligne le plus tendu au moins tendu)</h3>
        <table class="grid">
            <thead><tr><th>Type de ligne</th><th>Voyages</th><th>Demande simultanée max</th><th>Bus compatibles</th><th>Tension</th><th>Affectés</th></tr></thead>
            <tbody>
                @foreach (var phase in _report.Phases)
                {
                    <tr class="@(phase.Tension > 1 ? "row-hard" : "")">
                        <td>@phase.Label</td>
                        <td>@phase.TripCount</td>
                        <td>@phase.PeakDemand</td>
                        <td>@phase.CompatibleBuses</td>
                        <td>@phase.Tension.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td>@phase.Assigned / @phase.TripCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_report.Alns is not null)
    {
        <h3>Métaheuristique ALNS</h3>
        <p>
            @_report.Alns.Iterations itérations en @_report.Alns.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s —
            objectif @Number(_report.Alns.InitialObjective) → @Number(_report.Alns.FinalObjective).
        </p>
        <ConvergenceChart Points="_report.Alns.Convergence" />
        <table class="grid">
            <thead><tr><th>Opérateur</th><th>Type</th><th>Utilisations</th><th>Récompense cumulée</th><th>Poids final</th></tr></thead>
            <tbody>
                @foreach (var op in _report.Alns.Operators)
                {
                    <tr>
                        <td>@op.Name</td>
                        <td>@(op.IsDestroy ? "Destruction" : "Réparation")</td>
                        <td>@op.Uses</td>
                        <td>@op.TotalReward.ToString("0.#", CultureInfo.InvariantCulture)</td>
                        <td>@op.FinalWeight.ToString("0.00", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_report.Failures.Count > 0)
    {
        <h3>Voyages non affectés (@_report.Failures.Count)</h3>
        <table class="grid">
            <thead><tr><th>Départ</th><th>Arrivée</th><th>Ligne</th><th>Ressources manquantes</th><th>Causes de rejet (règle × nombre de ressources)</th></tr></thead>
            <tbody>
                @foreach (var failure in _report.Failures)
                {
                    <tr class="row-hard">
                        <td>@failure.Trip.Departure.ToString("HH:mm")</td>
                        <td>@failure.Trip.Arrival.ToString("HH:mm")</td>
                        <td>@failure.Trip.LineLabel</td>
                        <td>@string.Join(", ", failure.MissingRoles.Select(RoleLabel))</td>
                        <td>@Causes(failure)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @RenderFeasibilityIfProblem(_report.Feasibility)

    <h3>Plan d'allocation (@_report.Assignments.Count)</h3>
    var planRows = FilteredAssignments().ToList();

    <div class="plan-filters">
        <label class="filter-cell">
            Recherche libre (code ou libellé)
            <input type="search" placeholder="Ligne, matricule, nom…" @bind="_filter" @bind:event="oninput" />
        </label>
        <label class="filter-cell">
            Ligne (DENUMLI)
            <select @bind="_filterLineId">
                <option value="">Toutes</option>
                @foreach (var l in PlanLines())
                {
                    <option value="@l.Id">@l.Id — @l.Label</option>
                }
            </select>
        </label>
        <label class="filter-cell">
            Bus (matricule / code)
            <select @bind="_filterBusId">
                <option value="">Tous</option>
                @foreach (var b in PlanBuses())
                {
                    <option value="@b.Id">@b.Plate (code @b.Id)</option>
                }
            </select>
        </label>
        <label class="filter-cell">
            Chauffeur (matricule / nom)
            <select @bind="_filterDriverId">
                <option value="">Tous</option>
                @foreach (var d in PlanDrivers())
                {
                    <option value="@d.Id">@d.Id — @d.Name</option>
                }
            </select>
        </label>
        <label class="filter-cell">
            Receveur (matricule / nom)
            <select @bind="_filterReceiverId">
                <option value="">Tous</option>
                @foreach (var r in PlanReceivers())
                {
                    <option value="@r.Id">@r.Id — @r.Name</option>
                }
            </select>
        </label>
        <div class="filter-cell">
            <button class="btn" @onclick="ResetPlanFilters" title="Réinitialiser les filtres du plan">Réinitialiser</button>
        </div>
        <div class="filter-count">@planRows.Count / @_report.Assignments.Count voyage(s) affiché(s)</div>
    </div>
    <table class="grid">
        <thead><tr><th>Départ</th><th>Arrivée</th><th>Ligne</th><th>Bus</th><th>Chauffeur</th><th>Receveur</th><th>Score</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in planRows)
            {
                <tr class="clickable" title="Clic : fiche complète du voyage — survol : justification du score"
                    @onclick="() => OpenDetail(a)">
                    <td>@a.Trip.Departure.ToString("HH:mm")</td>
                    <td>@a.Trip.Arrival.ToString("HH:mm")</td>
                    <td><code>@a.Trip.LineId</code> @a.Trip.LineLabel</td>
                    <td>@a.Bus.Plate <span class="muted small">(code @a.Bus.Id)</span></td>
                    <td>@a.Driver.Name <span class="muted small">(@a.Driver.Id)</span></td>
                    <td>@a.Receiver.Name <span class="muted small">(@a.Receiver.Id)</span></td>
                    <td>
                        <div class="scorebar" title="@a.Justification">
                            <div class="fill" style="width:@Percent(a.Score, a.MaxScore)%"></div>
                            <span>@Number(a.Score) / @Number(a.MaxScore)</span>
                        </div>
                    </td>
                    <td>
                        @* Garde ton icône « pourquoi » actuelle ; le stopPropagation évite d'ouvrir la fiche en cliquant dessus *@
                        <button class="icon-btn" title="Pourquoi ce score ?"
                                @onclick="() => Explain(a.Trip.Id)" @onclick:stopPropagation="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </button>
                    </td>
                </tr>
            }
            @if (planRows.Count == 0)
            {
                <tr><td colspan="8" class="muted">Aucun voyage ne correspond aux filtres.</td></tr>
            }
        </tbody>
    </table>
    @* <p class="muted small">Survolez une ligne pour voir la justification du score critère par critère.</p> *@
    <p class="muted small">
        Cliquez sur une ligne pour ouvrir la fiche complète (voyage, bus, chauffeur, receveur, score).
        Survolez une ligne pour voir la justification du score critère par critère.
    </p>


    @if (_report.Fairness is { } fairness)
    {
        <h3>Équité du partage des ressources</h3>
        <p class="muted small">
            Indice de Jain : 1 = parfaitement égal. Coefficient de variation (CV) : plus il est bas, plus c'est équitable.
            « Non utilisées » compte les ressources disponibles qui n'ont reçu aucun voyage.
        </p>
        <table class="grid">
            <thead>
                <tr>
                    <th>Indicateur</th>
                    <th>Ressources</th>
                    <th>Non utilisées</th>
                    <th>Moyenne</th>
                    <th>Min</th>
                    <th>Max</th>
                    <th>Écart-type</th>
                    <th>CV</th>
                    <th>Jain</th>
                    <th>Verdict</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in fairness.Indicators)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.Count</td>
                        <td>@s.Unused</td>
                        <td>@Number(s.Mean) @s.Unit</td>
                        <td>@Number(s.Min)</td>
                        <td>@Number(s.Max)</td>
                        <td>@Number(s.StdDev)</td>
                        <td>@s.Cv.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td>@s.Jain.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td><span class="badge @(s.Css == "ok" ? "soft" : s.Css == "warn" ? "off" : "hard")">@s.Verdict</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
@if (_explanation is not null && _explained is not null)
{
    <div class="drawer-overlay" @onclick="CloseWhy"></div>
    <aside class="drawer wide">
        <div class="drawer-header">
            <div>
                <h2>Pourquoi ces ressources ?</h2>
                <span class="muted small">@_explained.Trip.LineLabel · @_explained.Trip.Departure.ToString("HH:mm") → @_explained.Trip.Arrival.ToString("HH:mm")</span>
            </div>
            <button class="drawer-close" @onclick="CloseWhy" title="Fermer">✕</button>
        </div>
        <div class="drawer-body">
            @RenderDecision(_explanation.Bus)
            @RenderDecision(_explanation.Driver)
            @RenderDecision(_explanation.Receiver)
        </div>
    </aside>
}
@if (_detail is not null)
{
    <div class="drawer-overlay" @onclick="CloseDetail"></div>
    <aside class="drawer wide">
        <div class="drawer-header">
            <div>
                <h2>Voyage #@_detail.Trip.Id — @_detail.Trip.Departure.ToString("dd/MM/yyyy")</h2>
                <span class="muted small">@_detail.Trip.Departure.ToString("HH:mm") → @_detail.Trip.Arrival.ToString("HH:mm")</span>
            </div>
            <button class="drawer-close" @onclick="CloseDetail" title="Fermer">✕</button>
        </div>
        <div class="drawer-body">
            <h3>Voyage</h3>
            <table class="grid">
                <tbody>
                    <tr><td>Code ligne (DENUMLI)</td><td><code>@_detail.Trip.LineId</code></td></tr>
                    <tr><td>Libellé ligne (Fr)</td><td>@_detail.Trip.LineLabel</td></tr>
                    @* <tr><td>Libellé ligne (Ar)</td><td>@_detail.Trip.</td></tr> *@
                    <tr><td>Type de ligne</td><td>@Ref(_lineTypeLabels, _detail.Trip.LineTypeId, "Type")</td></tr>
                    <tr><td>Durée</td><td>@((int)_detail.Trip.Interval.Duration.TotalMinutes) min</td></tr>
                    <tr><td>Distance</td><td>@Number(_detail.Trip.DistanceKm) km</td></tr>
                    <tr><td>Centre de la ligne</td><td>@(_detail.Trip.CenterId?.ToString() ?? "—")</td></tr>
                    <tr><td>Délégation de la ligne</td><td>@Ref(_delegationLabels, _detail.Trip.DelegationId, "Délégation")</td></tr>
                    @* <tr><td>Station départ</td><td>@Station(_detail.Trip.OriginStationId)</td></tr>
                    <tr><td>Station arrivée</td><td>@Station(_detail.Trip.DestinationStationId)</td></tr> *@
                    <tr><td>Station départ (origine de la ligne)</td><td>@Station(_detailOrigin)</td></tr>
                    <tr><td>Station arrivée (terminus de la ligne)</td><td>@Station(_detailDestination)</td></tr>
                    <tr><td>Demande prévue</td><td>@(_detail.Trip.ExpectedPassengers?.ToString() ?? "inconnue (donnée absente de la base)")</td></tr>
                </tbody>
            </table>
            <h3>Bus affecté</h3>
            <table class="grid">
                <tbody>
                    <tr><td>Code bus (DECODVH)</td><td><code>@_detail.Bus.Id</code></td></tr>
                    <tr><td>Matricule (DEMATRI)</td><td>@_detail.Bus.Plate</td></tr>
                    <tr><td>Catégorie</td><td>@Ref(_categoryLabels, _detail.Bus.CategoryId, "Catégorie")</td></tr>
                    <tr><td>Capacité</td><td>@_detail.Bus.Capacity places (@_detail.Bus.Seats assises + @_detail.Bus.Standing debout)</td></tr>
                    <tr><td>Centre</td><td>@(_detail.Bus.CenterId?.ToString() ?? "—")</td></tr>
                    <tr><td>Délégation</td><td>@Ref(_delegationLabels, _detail.Bus.DelegationId, "Délégation")</td></tr>
                    <tr><td>Mise en circulation</td><td>@(_detail.Bus.InServiceSince?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                    <tr><td>Actif</td><td>@(_detail.Bus.Active ? "oui" : "non")</td></tr>
                </tbody>
            </table>
            <h3>Chauffeur</h3>
            @AgentTable(_detail.Driver)
            <h3>Receveur</h3>
            @AgentTable(_detail.Receiver)
            <h3>Score : @Number(_detail.Score) / @Number(_detail.MaxScore)</h3>
            <ul class="small">
                @foreach (var part in _detail.Justification.Split(" | ", StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@part</li>
                }
            </ul>
            <div class="toolbar">
                <button class="btn primary" @onclick="LoadDetailWhy">Pourquoi ces ressources ? (analyse complète)</button>
            </div>
            @if (_detailWhy is not null)
            {
                @RenderDecision(_detailWhy.Bus)
                @RenderDecision(_detailWhy.Driver)
                @RenderDecision(_detailWhy.Receiver)
            }
        </div>
    </aside>
}
@code {
    // ------------------------------------------------------------------ filtres du plan (codes + libellés)
    private long? _filterLineId;
    private long? _filterBusId;
    private long? _filterDriverId;
    private long? _filterReceiverId;

    // ------------------------------------------------------------------ fiche détail d'une affectation
    private TripAssignment? _detail;
    private TripExplanation? _detailWhy;

    private async Task OpenDetail(TripAssignment a)
    {
        _detail = a;
        _detailWhy = null;
        _stationLabels = new Dictionary<long, (string, string?)>();
        _detailOrigin = a.Trip.OriginStationId;
        _detailDestination = a.Trip.DestinationStationId;
        try
        {
            // Itinéraire de la ligne (dritin joint drstati) : arrêts triés par séquence.
            var stops = (await LineService.GetItineraryAsync(a.Trip.LineId)).Stops
                .OrderBy(s => s.Sequence).ToList();

            _stationLabels = stops
                .Where(s => s.StationId is not null)
                .GroupBy(s => s.StationId!.Value)
                .ToDictionary(g => g.Key,
                              g => (g.First().NameFr ?? $"Station {g.Key}", g.First().NameAr));

            // Le voyage ne porte pas de codes stations : on prend les deux terminus de l'itinéraire.
            _detailOrigin ??= stops.FirstOrDefault()?.StationId;
            _detailDestination ??= stops.LastOrDefault()?.StationId;

            // Si votre record Trip expose Direction (1 = aller, 2 = retour), décommentez :
            // if (a.Trip.Direction == 2) (_detailOrigin, _detailDestination) = (_detailDestination, _detailOrigin);
        }
        catch { /* itinéraire illisible : les stations s'affichent par leur code */ }
    }
    private void CloseDetail()
    {
        _detail = null;
        _detailWhy = null;
        _stationLabels = new Dictionary<long, (string, string?)>();
        _detailOrigin = null;
        _detailDestination = null;
    }
    private void LoadDetailWhy() { if (_detail is not null) _detailWhy = _report?.Explainer?.Explain(_detail.Trip.Id); }

    /// <summary>Valeurs présentes dans le plan courant pour alimenter les filtres (codes + libellés).</summary>
