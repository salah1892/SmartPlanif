    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Percent(double score, double max) =>
        (max <= 0 ? 0 : Math.Clamp(score / max * 100, 0, 100)).ToString("0", CultureInfo.InvariantCulture);

    /// <summary>Motif du score extrait de la justification : « B07=25 » -> « même centre que la ligne +25 ».</summary>
    // private static readonly System.Text.RegularExpressions.Regex ScorePointsRegex =
    //     new(@"\b(?<code>[A-Z]{1,2}P?\d{2})=(?<pts>\d+(?:[.,]\d+)?)", System.Text.RegularExpressions.RegOptions.Compiled);
    /// <summary>Extrait les couples « CODE=points » de la justification (ex. « B07=25 »).</summary>
    private static readonly System.Text.RegularExpressions.Regex ScorePointsRegex =
        new(@"\b(?<code>[A-Z]{1,2}P?\d{2})=(?<pts>\d+(?:[.,]\d+)?)", System.Text.RegularExpressions.RegexOptions.Compiled);
    /// <summary>Survol de l'icône « pourquoi » : le score expliqué en phrases courtes (une ligne par rôle).</summary>
    private static string ScoreWhy(TripAssignment a)
    {
        if (string.IsNullOrWhiteSpace(a.Justification))
            return $"Score {Number(a.Score)} / {Number(a.MaxScore)} : clic pour le détail complet.";
        var sb = new System.Text.StringBuilder();
        sb.Append($"Pourquoi ce score ({Number(a.Score)} / {Number(a.MaxScore)}) ? Points gagnés, par rôle :");
        foreach (var segment in a.Justification.Split(" | ", StringSplitOptions.RemoveEmptyEntries))
        {
            sb.Append('\n').Append("• ");
            var bracket = segment.IndexOf(" [", StringComparison.Ordinal);
            sb.Append(bracket >= 0 ? segment[..bracket] : segment);
            var details = ScorePointsRegex.Matches(segment);
            if (details.Count > 0)
            {
                sb.Append(" → ");
                sb.Append(string.Join(", ", details.Select(m =>
                {
                    var code = m.Groups["code"].Value;
                    var name = ConstraintCatalog.FindDescriptor(code) is { } d ? d.Name.ToLowerInvariant() : code.ToLowerInvariant();
                    var pts = double.TryParse(m.Groups["pts"].Value.Replace(',', '.'),
                        NumberStyles.Float, CultureInfo.InvariantCulture, out var p) ? p : 0;
                    return $"{name} +{Number(pts)}";
                })));
            }
        }
        sb.Append("\nClic : détail complet (rang, alternatives, rejets par règle dure).");
        return sb.ToString();
    }
    /// <summary>Libellé de la table mère pour une clé étrangère : « LIBELLÉ (code) », sinon code seul.</summary>
    private static string Ref(IReadOnlyDictionary<long, string> map, long? id, string prefix) =>
        id is null ? "—"
        : map.TryGetValue(id.Value, out var label) ? $"{label} (code {id})"
        : $"{prefix} {id}";

    /// <summary>Station complète : nom français + nom arabe + code (drstati.DELSTAT / DELSTAA).</summary>
    private string Station(long? id)
    {
        if (id is null) return "—";
        if (!_stationLabels.TryGetValue(id.Value, out var names))
            return $"Station {id} (nom absent de drstati)";
        var ar = string.IsNullOrWhiteSpace(names.Ar) ? null : $" — {names.Ar}";
        return $"{names.Fr}{ar} (code {id})";
    }

