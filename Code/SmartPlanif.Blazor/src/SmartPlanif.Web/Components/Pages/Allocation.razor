@page "/allocation"
@using System.Globalization
@inject AllocateDayHandler AllocateHandler
@inject PreviewDayHandler PreviewHandler
@inject PlanningCalendar Calendar

<PageTitle>Allocation</PageTitle>

<h1>Allocation d'une journée</h1>

<p class="muted">
    Planification à partir d'<strong>aujourd'hui</strong> (@Calendar.Today.ToString("dd/MM/yyyy")). Les journées passées sont consultables
    mais <strong>grisées</strong> : elles ne sont ni planifiables ni modifiables.
</p>

<div class="panel @(IsPast ? "past" : "")">
    <div class="form-grid compact">
        <label>Date (à partir du @Calendar.Today.ToString("dd/MM/yyyy"))
            <input type="date" @bind="_dateInput" min="@Calendar.Today.ToString("yyyy-MM-dd")" disabled="@_running" /></label>
        <label>Méthode
            <select @bind="_method" disabled="@(_running || IsPast)">
                @foreach (var method in Enum.GetValues<AllocationMethod>())
                {
                    <option value="@method">@MethodLabel(method)</option>
                }
            </select></label>
        @* <label>Utilisateur
            <input type="text" @bind="_user" disabled="@(_running || IsPast)" /></label> *@
        <label>Voyages déjà planifiés
            <select @bind="_existingMode" disabled="@(_running || IsPast)">
                <option value="@ExistingPlanMode.FillMissingOnly">Compléter : garder les plans existants</option>
                <option value="@ExistingPlanMode.ReplaceDay">Remplacer : replanifier toute la journée</option>
            </select></label>
        <label>Enregistrement dans la table trips
            <select @bind="_saveMode" disabled="@(_running || IsPast)">
                <option value="@SaveMode.None">Aucun (simulation)</option>
                <option value="@SaveMode.CompleteDayOnly">Journée complète seulement</option>
                <option value="@SaveMode.AllowPartial">Même si la journée est incomplète</option>
            </select></label>
    </div>
    <div class="toolbar">
        <button class="btn" @onclick="PreviewAsync" disabled="@_running">Analyser la faisabilité</button>
        <button class="btn primary" @onclick="RunAsync" disabled="@(_running || IsPast)">Lancer l'allocation</button>
        @if (_running)
        {
            <button class="btn danger" @onclick="Cancel">Arrêter</button>
        }
    </div>
</div>

@if (IsPast)
{
    <div class="alert warn">
        🔒 Le @SelectedDate.ToString("dd/MM/yyyy") est une journée passée : elle n'est pas éligible à la planification.
        Choisissez une date à partir du @Calendar.Today.ToString("dd/MM/yyyy"). Vous pouvez toujours consulter son plan dans « Plan enregistré ».
    </div>
}

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}

@if (_running)
{
    <div class="alert warn">
        Calcul en cours…
        @if (_progress is not null)
        {
            <span>
                itération @_progress.Iteration — meilleur objectif @_progress.BestObjective.ToString("0.#", CultureInfo.InvariantCulture)
                — voyages non affectés : @_progress.UnassignedInBest — @_progress.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s
            </span>
        }
    </div>
}

@if (_preview is not null)
{
    <h2>Aperçu de la journée du @_preview.Date.ToString("dd/MM/yyyy")</h2>
    <p>
        <strong>@_preview.DayTrips</strong> voyages ce jour-là : <strong>@_preview.TripsToAllocate</strong> à planifier,
        @_preview.AlreadyPlannedInDay avec un plan prévu déjà enregistré, @_preview.RealizedInDay déjà effectués (ressources réelles, jamais modifiés).
        @_preview.LockedTrips voyage(s) verrouillé(s) bloquent leurs ressources.
        @_preview.ActiveBuses bus actifs, @_preview.Drivers agents aptes au poste de chauffeur, @_preview.Receivers aptes au poste de receveur (chaque voyage en exige deux, différents).
        Répartition à planifier : @string.Join(", ", _preview.LineTypes.Select(t => $"{t.Label} : {t.TripCount}"))
    </p>
    @RenderFeasibility(_preview.Feasibility)
}

@if (_report is not null)
{
    <h2>Résultat — @MethodLabel(_report.Method)</h2>

    <div class="kpis">
        <div class="kpi @(_report.UnassignedCount == 0 ? "good" : "bad")">
            <span class="value">@_report.AssignedCount / @_report.TotalTrips</span><span>voyages affectés</span>
        </div>
        <div class="kpi @(_report.UnassignedCount == 0 ? "good" : "bad")">
            <span class="value">@_report.UnassignedCount</span><span>non affectés</span>
        </div>
        <div class="kpi">
            <span class="value">@Number(_report.ConstructionObjective) → @Number(_report.FinalObjective)</span><span>objectif (construction → final)</span>
        </div>
        <div class="kpi">
            <span class="value">@_report.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s</span><span>temps de calcul</span>
        </div>
        <div class="kpi @(_report.Violations.Count == 0 ? "good" : "bad")">
            <span class="value">@(_report.Violations.Count == 0 ? "Valide" : _report.Violations.Count + " violation(s)")</span><span>contrôle indépendant</span>
        </div>
    </div>

    @if (_report.Save is not null)
    {
        <div class="alert @(_report.Save.Success ? "ok" : "error")">@_report.Save.Message</div>
    }
    else if (_saveMode == SaveMode.None)
    {
        <div class="alert warn">Simulation : rien n'a été écrit dans la table trips.</div>
    }

    <h3>Contraintes appliquées</h3>
    <p>
        Dures :
        @foreach (var constraintCode in _report.HardConstraintCodes)
        {
            <span class="badge hard" title="@ConstraintCatalog.DescribeCode(constraintCode)">@constraintCode</span>
        }
    </p>
    <p>
        Souples :
        @foreach (var constraintCode in _report.SoftConstraintCodes)
        {
            <span class="badge soft" title="@ConstraintCatalog.DescribeCode(constraintCode)">@constraintCode</span>
        }
    </p>

    @if (_report.Violations.Count > 0)
    {
        <div class="alert error">
            <strong>Le contrôle indépendant a détecté des violations de règles dures (bug probable) :</strong>
            <ul>
                @foreach (var violation in _report.Violations.Take(20))
                {
                    <li>Voyage @violation.TripId — @violation.Resource — @ConstraintCatalog.DescribeCode(violation.Code) : @violation.Message</li>
                }
            </ul>
        </div>
    }

    @if (_report.Phases.Count > 0)
    {
        <h3>Phases de construction (du type de ligne le plus tendu au moins tendu)</h3>
        <table class="grid">
            <thead><tr><th>Type de ligne</th><th>Voyages</th><th>Demande simultanée max</th><th>Bus compatibles</th><th>Tension</th><th>Affectés</th></tr></thead>
            <tbody>
                @foreach (var phase in _report.Phases)
                {
                    <tr class="@(phase.Tension > 1 ? "row-hard" : "")">
                        <td>@phase.Label</td><td>@phase.TripCount</td><td>@phase.PeakDemand</td><td>@phase.CompatibleBuses</td>
                        <td>@phase.Tension.ToString("0.00", CultureInfo.InvariantCulture)</td><td>@phase.Assigned / @phase.TripCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_report.Alns is not null)
    {
        <h3>Métaheuristique ALNS</h3>
        <p>
            @_report.Alns.Iterations itérations en @_report.Alns.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s —
            objectif @Number(_report.Alns.InitialObjective) → @Number(_report.Alns.FinalObjective).
        </p>
        <ConvergenceChart Points="_report.Alns.Convergence" />
        <table class="grid">
            <thead><tr><th>Opérateur</th><th>Type</th><th>Utilisations</th><th>Récompense cumulée</th><th>Poids final</th></tr></thead>
            <tbody>
                @foreach (var op in _report.Alns.Operators)
                {
                    <tr>
                        <td>@op.Name</td><td>@(op.IsDestroy ? "Destruction" : "Réparation")</td><td>@op.Uses</td>
                        <td>@op.TotalReward.ToString("0.#", CultureInfo.InvariantCulture)</td><td>@op.FinalWeight.ToString("0.00", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_report.Failures.Count > 0)
    {
        <h3>Voyages non affectés (@_report.Failures.Count)</h3>
        <table class="grid">
            <thead><tr><th>Départ</th><th>Arrivée</th><th>Ligne</th><th>Ressources manquantes</th><th>Causes de rejet (règle × nombre de ressources)</th></tr></thead>
            <tbody>
                @foreach (var failure in _report.Failures)
                {
                    <tr class="row-hard">
                        <td>@failure.Trip.Departure.ToString("HH:mm")</td><td>@failure.Trip.Arrival.ToString("HH:mm")</td>
                        <td>@failure.Trip.LineLabel</td><td>@string.Join(", ", failure.MissingRoles.Select(RoleLabel))</td>
                        <td>@Causes(failure)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @RenderFeasibilityIfProblem(_report.Feasibility)

    <h3>Plan d'allocation (@_report.Assignments.Count)</h3>
    <div class="toolbar">
        <input type="search" placeholder="Filtrer (ligne, bus, agent)…" @bind="_filter" @bind:event="oninput" />
    </div>
    <table class="grid">
        <thead><tr><th>Départ</th><th>Arrivée</th><th>Ligne</th><th>Bus</th><th>Chauffeur</th><th>Receveur</th><th>Score</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in FilteredAssignments())
            {
                <tr title="@a.Justification">
                    <td>@a.Trip.Departure.ToString("HH:mm")</td><td>@a.Trip.Arrival.ToString("HH:mm")</td>
                    <td>@a.Trip.LineLabel</td><td>@a.Bus.Plate</td><td>@a.Driver.Name</td><td>@a.Receiver.Name</td>
                    <td>
                        <div class="scorebar" title="@a.Justification">
                            <div class="fill" style="width:@Percent(a.Score, a.MaxScore)%"></div>
                            <span>@a.Score.ToString("0.#", CultureInfo.InvariantCulture) / @a.MaxScore.ToString("0.#", CultureInfo.InvariantCulture)</span>
                        </div>
                    </td>
                    <td><button class="btn small" @onclick="() => Explain(a.Trip.Id)">Pourquoi ?</button></td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted small">Survolez une ligne pour voir la justification du score critère par critère.</p>


@if (_report.Fairness is { } fairness)
{
    <h3>Équité du partage des ressources</h3>
    <p class="muted small">
        Indice de Jain : 1 = parfaitement égal. Coefficient de variation (CV) : plus il est bas, plus c'est équitable.
        « Non utilisées » compte les ressources disponibles qui n'ont reçu aucun voyage.
    </p>
    <table class="grid">
        <thead>
            <tr>
                <th>Indicateur</th>
                <th>Ressources</th>
                <th>Non utilisées</th>
                <th>Moyenne</th>
                <th>Min</th>
                <th>Max</th>
                <th>Écart-type</th>
                <th>CV</th>
                <th>Jain</th>
                <th>Verdict</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in fairness.Indicators)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Count</td>
                    <td>@s.Unused</td>
                    <td>@Number(s.Mean) @s.Unit</td>
                    <td>@Number(s.Min)</td>
                    <td>@Number(s.Max)</td>
                    <td>@Number(s.StdDev)</td>
                    <td>@s.Cv.ToString("0.00", CultureInfo.InvariantCulture)</td>
                    <td>@s.Jain.ToString("0.00", CultureInfo.InvariantCulture)</td>
                    <td><span class="badge @(s.Css == "ok" ? "soft" : s.Css == "warn" ? "off" : "hard")">@s.Verdict</span></td>
                </tr>
            }
        </tbody>
    </table>
    }
}
@if (_explanation is not null && _explained is not null)
{
    <div class="drawer-overlay" @onclick="CloseWhy"></div>
    <aside class="drawer wide">
        <div class="drawer-header">
            <div>
                <h2>Pourquoi ces ressources ?</h2>
                <span class="muted small">@_explained.Trip.LineLabel · @_explained.Trip.Departure.ToString("HH:mm") → @_explained.Trip.Arrival.ToString("HH:mm")</span>
            </div>
            <button class="drawer-close" @onclick="CloseWhy" title="Fermer">✕</button>
        </div>
        <div class="drawer-body">
            @RenderDecision(_explanation.Bus)
            @RenderDecision(_explanation.Driver)
            @RenderDecision(_explanation.Receiver)
        </div>
    </aside>
}
@code {
    //============================================================//
    private TripExplanation? _explanation;
    private TripAssignment? _explained;

    private void Explain(long tripId)
    {
        _explained = _report!.Assignments.First(a => a.Trip.Id == tripId);
        _explanation = _report.Explainer?.Explain(tripId);
    }
    private void CloseWhy() { _explanation = null; _explained = null; }

    private static string CritCss(double v) => v >= 0.75 ? "good" : v >= 0.4 ? "mid" : "low";

    private RenderFragment RenderDecision(ResourceDecision d) => __builder =>
    {
        <section class="why-card">
            <h3>
                @d.Role : <span class="why-chosen">@d.ChosenLabel</span>
                <span class="badge soft">@Number(d.Score) / @Number(d.MaxScore) pts</span>
                <span class="badge @(d.Rank == 1 ? "soft" : "off")">rang @d.Rank / @d.EligibleCount</span>
            </h3>
            <p class="why-summary">@d.Summary</p>

            @foreach (var c in d.Criteria)
            {
                <div class="crit-row">
                    <span class="crit-name" title="@c.Code">@c.Name</span>
                    <div class="crit-bar"><div class="crit-fill @CritCss(c.Value)" style="width:@Percent(c.Value, 1)%"></div></div>
                    <span class="crit-pts">@Number(c.Points) / @Number(c.Weight)</span>
                    @if (c.Note is not null)
                    {
                        <div class="crit-note muted small">@c.Note</div>
                    }
                </div>
            }

            <p class="muted small">
                Charge ce jour-là (hors ce voyage) : <strong>@Number(d.ChosenHours) h</strong>
                — moyenne des candidats : <strong>@Number(d.AverageHours) h</strong>
            </p>

            @if (d.Alternatives.Count > 0)
            {
                <table class="grid">
                    <thead><tr><th>Alternative</th><th>Score</th><th>Écart</th><th>Ce qui la désavantage</th></tr></thead>
                    <tbody>
                        @foreach (var alt in d.Alternatives)
                        {
                            <tr>
                                <td>@alt.Label</td>
                                <td>@Number(alt.Score)</td>
                                <td>@(alt.Gap >= 0 ? "−" : "+")@Number(Math.Abs(alt.Gap))</td>
                                <td class="small">
                                    @string.Join(" ; ", alt.Deltas.Select(x =>
                                    $"{x.Name} ({(x.Delta >= 0 ? "+" : "")}{Number(x.Delta)}{(x.OtherNote is null ? "" : " : " + x.OtherNote)})"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (d.Rejections.Count > 0)
            {
                <details>
                    <summary>@d.RejectedCount éliminé(s) par une règle dure</summary>
                    <ul class="small">
                        @foreach (var r in d.Rejections)
                        {
                            <li><strong>@r.Name</strong> × @r.Count — @string.Join(", ", r.Examples)@(r.Count > r.Examples.Count ? "…" : "")</li>
                        }
                    </ul>
                </details>
            }
        </section>
    };
    //============================================================//
    private DateTime _dateInput;
    private AllocationMethod _method = AllocationMethod.GreedyChronological;
    private string _user = "planificateur";
    private SaveMode _saveMode = SaveMode.None;
    private ExistingPlanMode _existingMode = ExistingPlanMode.FillMissingOnly;
    private bool _running;
    private string? _error;
    private string _filter = "";
    private AlnsProgress? _progress;
    private AllocationReport? _report;
    private DayPreview? _preview;
    private CancellationTokenSource? _cancellation;

    private DateOnly SelectedDate => DateOnly.FromDateTime(_dateInput);

    /// <summary>Journée passée : tous les contrôles de planification sont grisés.</summary>
    private bool IsPast => !Calendar.IsEditable(SelectedDate);

    protected override void OnInitialized() => _dateInput = Calendar.Today.ToDateTime(TimeOnly.MinValue);

    /// <summary>Phase 0 : volumes et diagnostic de faisabilité, sans rien modifier.</summary>
    private async Task PreviewAsync()
    {
        _error = null;
        try
        {
            _preview = await PreviewHandler.HandleAsync(SelectedDate, _existingMode, null, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = "Analyse impossible : " + ex.Message;
        }
    }

    /// <summary>Lance l'allocation ; la métaheuristique tourne sur un fil d'arrière-plan et publie sa progression.</summary>
    private async Task RunAsync()
    {
        _error = null;
        _report = null;
        _progress = null;
        _running = true;
        _cancellation = new CancellationTokenSource();
        try
        {
            var progress = new InlineProgress<AlnsProgress>(p =>
            {
                _progress = p;
                _ = InvokeAsync(StateHasChanged);
            });
            var command = new AllocateDayCommand(SelectedDate, _user, _method, _saveMode, _existingMode);
            _report = await AllocateHandler.HandleAsync(command, progress, _cancellation.Token);
        }
        catch (Exception ex)
        {
            _error = "Allocation impossible : " + ex.Message;
        }
        finally
        {
            _running = false;
            _cancellation?.Dispose();
            _cancellation = null;
        }
    }

    /// <summary>Arrêt demandé : la recherche rend le meilleur plan trouvé jusque-là.</summary>
    private void Cancel() => _cancellation?.Cancel();

    private IEnumerable<TripAssignment> FilteredAssignments()
    {
        var all = _report!.Assignments;
        if (string.IsNullOrWhiteSpace(_filter)) return all;
        var text = _filter.Trim();
        return all.Where(a =>
            a.Trip.LineLabel.Contains(text, StringComparison.OrdinalIgnoreCase)
            || a.Bus.Plate.Contains(text, StringComparison.OrdinalIgnoreCase)
            || a.Driver.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
            || a.Receiver.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private RenderFragment RenderFeasibility(IReadOnlyList<FeasibilityLine> lines) => __builder =>
    {
        <table class="grid">
            <thead><tr><th>Ressource</th><th>Demande minimale</th><th>Disponible</th><th>Diagnostic</th></tr></thead>
            <tbody>
                @foreach (var line in lines)
                {
                    <tr class="@(line.IsSufficient ? "" : "row-hard")">
                        <td>@line.Scope</td><td>@line.Demand</td><td>@line.Supply</td><td>@line.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    };

    /// <summary>Affiche le diagnostic seulement s'il révèle une pénurie : c'est souvent la vraie cause des voyages non affectés.</summary>
    private RenderFragment RenderFeasibilityIfProblem(IReadOnlyList<FeasibilityLine> lines) => __builder =>
    {
        if (lines.Any(l => !l.IsSufficient))
        {
            <h3>Pénuries détectées avant l'allocation</h3>
            <p class="muted">Ces ressources sont insuffisantes quelle que soit la méthode : il faut en ajouter ou assouplir une contrainte.</p>
            @RenderFeasibility(lines.Where(l => !l.IsSufficient).ToList())
        }
    };

    private static string Causes(UnassignedTrip failure) =>
        failure.RejectionsByCode.Count == 0
            ? "Aucune ressource de ce rôle n'existe dans le parc."
            : string.Join(" ; ", failure.RejectionsByCode.OrderByDescending(x => x.Value)
                .Select(x => $"{ConstraintCatalog.DescribeCode(x.Key)} × {x.Value}"));

    private static string RoleLabel(string role) => role switch
    {
        "BUS" => "bus",
        "DRIVER" => "chauffeur",
        "RECEIVER" => "receveur",
        _ => role,
    };

    private static string MethodLabel(AllocationMethod method) => method switch
    {
        AllocationMethod.GreedyChronological => "1. Glouton chronologique (référence)",
        AllocationMethod.PhasedConstruction => "2. Construction par phases (types de ligne)",
        _ => "3. Construction par phases + ALNS (recommandé)",
    };

    private static string Number(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string Percent(double score, double max) =>
        (max <= 0 ? 0 : Math.Clamp(score / max * 100, 0, 100)).ToString("0", CultureInfo.InvariantCulture);
}
