    private bool _running;
    private string? _error;
    private string _filter = "";
    private AlnsProgress? _progress;
    private AllocationReport? _report;
    private DayPreview? _preview;
    private CancellationTokenSource? _cancellation;

    private DateOnly SelectedDate => DateOnly.FromDateTime(_dateInput);

    /// <summary>Journée passée : tous les contrôles de planification sont grisés.</summary>
    private bool IsPast => !Calendar.IsEditable(SelectedDate);

    private IReadOnlyDictionary<long, string> _lineTypeLabels = new Dictionary<long, string>();
    private IReadOnlyDictionary<long, string> _categoryLabels = new Dictionary<long, string>();
    private IReadOnlyDictionary<long, string> _delegationLabels = new Dictionary<long, string>();
    /// <summary>Noms des stations (drstati) : DELSTAT français + DELSTAA arabe, par code DECSTAT.</summary>
    private IReadOnlyDictionary<long, (string Fr, string? Ar)> _stationLabels =
        new Dictionary<long, (string, string?)>();
    private long? _detailOrigin;
    private long? _detailDestination;

    private readonly CancellationTokenSource _cts = new();

    //protected override void OnInitialized() => _dateInput = Calendar.Today.ToDateTime(TimeOnly.MinValue);
    protected override async Task OnInitializedAsync()
    {
        _dateInput = Calendar.Today.ToDateTime(TimeOnly.MinValue);
        var ct = _cts.Token;
        // Libellés des tables mères (drtyli, drcatve, drdeleg) : une seule lecture au chargement de la page.
        try { _lineTypeLabels = (await Reference.GetLineTypesAsync(ct)).ToDictionary(x => x.Id, x => x.Label); } catch { }
        try { _categoryLabels = (await Reference.GetBusCategoriesAsync(ct)).ToDictionary(x => x.Id, x => x.Label); } catch { }
        try { _delegationLabels = (await Reference.GetDelegationsAsync(ct)).ToDictionary(x => x.Id, x => x.Label); } catch { }
    }

    /// <summary>Phase 0 : volumes et diagnostic de faisabilité, sans rien modifier.</summary>
    private async Task PreviewAsync()
    {
        _error = null;
        try
        {
            _preview = await PreviewHandler.HandleAsync(SelectedDate, _existingMode, null, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = "Analyse impossible : " + ex.Message;
        }
    }

    /// <summary>Lance l'allocation ; la métaheuristique tourne sur un fil d'arrière-plan et publie sa progression.</summary>
    private async Task RunAsync()
    {
        _error = null;
        _report = null;
        _progress = null;
        _running = true;
        _cancellation = new CancellationTokenSource();
        _detail = null;
        _detailWhy = null;
        try
        {
            var progress = new InlineProgress<AlnsProgress>(p =>
            {
                _progress = p;
                _ = InvokeAsync(StateHasChanged);
            });
            var command = new AllocateDayCommand(SelectedDate, _user, _method, _saveMode, _existingMode);
            _report = await AllocateHandler.HandleAsync(command, progress, _cancellation.Token);
        }
        catch (Exception ex)
        {
            _error = "Allocation impossible : " + ex.Message;
        }
        finally
        {
            _running = false;
            _cancellation?.Dispose();
            _cancellation = null;
        }
    }

    /// <summary>Arrêt demandé : la recherche rend le meilleur plan trouvé jusque-là.</summary>
    private void Cancel() => _cancellation?.Cancel();

    private IEnumerable<TripAssignment> FilteredAssignments()
    {
        // var all = _report!.Assignments;
        // if (string.IsNullOrWhiteSpace(_filter)) return all;
        // var text = _filter.Trim();
        // return all.Where(a =>
        //     a.Trip.LineLabel.Contains(text, StringComparison.OrdinalIgnoreCase)
        //     || a.Bus.Plate.Contains(text, StringComparison.OrdinalIgnoreCase)
        //     || a.Driver.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
        //     || a.Receiver.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        var all = _report!.Assignments.AsEnumerable();
        if (_filterLineId is { } line) all = all.Where(a => a.Trip.LineId == line);
        if (_filterBusId is { } bus) all = all.Where(a => a.Bus.Id == bus);
        if (_filterDriverId is { } drv) all = all.Where(a => a.Driver.Id == drv);
        if (_filterReceiverId is { } rec) all = all.Where(a => a.Receiver.Id == rec);
        var text = _filter.Trim();
        if (text.Length > 0)
            all = all.Where(a =>
                a.Trip.LineLabel.Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Trip.LineId.ToString().Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Bus.Plate.Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Bus.Id.ToString().Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Driver.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Driver.Id.ToString().Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Receiver.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
                || a.Receiver.Id.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        return all;
    }

