@page "/buses"
@using System.Globalization
@inject BusQueryService BusService
@inject PlanningCalendar Calendar

<PageTitle>Bus</PageTitle>

<h1>Parc de bus</h1>
<p class="muted">
    Liste des bus de la table <code>drvehic</code> (lecture seule), classés par catégorie, centre (dépôt), délégation, ligne ou âge.
    Le lien bus ↔ ligne vient des voyages (<code>trips</code>) du <strong>jour choisi</strong> ci-dessous.
</p>

@if (_loading)
{
    <p>Chargement…</p>
}
else if (_error is not null)
{
    <div class="alert error">@_error</div>
}
else
{
    var now = DateTime.Today;
    var filtered = BusQuery.Apply(_all, CurrentFilter(), _sort, _desc, now);
    var pageCount = BusQuery.PageCount(filtered.Count, PageSize);
    if (_page > pageCount) _page = pageCount;
    var rows = BusQuery.Page(filtered, _page, PageSize);
    var groups = _group == BusGroup.Line ? BusQuery.SummarizeByLine(_all, _usage) : BusQuery.Summarize(_all, _group, now);

    <div class="kpis">
        <div class="kpi"><span class="value">@_all.Count</span><span>bus au total</span></div>
        <div class="kpi"><span class="value">@filtered.Count</span><span>correspondent aux filtres</span></div>
        <div class="kpi"><span class="value">@filtered.Sum(b => b.Capacity)</span><span>places (assises + debout) filtrées</span></div>
        <div class="kpi"><span class="value">@_all.Count(b => b.ActiveFlag == 0)</span><span>Bus prêt</span></div>
        <div class="kpi"><span class="value">@_usageBusCount</span><span>bus utilisés le @_usageDate.ToString("dd/MM/yyyy")</span></div>
    </div>

    @if (_all.Count > 0 && _all.All(b => b.ActiveFlag != 0))
    {
        <div class="alert warn">
            <code>DEACTIF</code> ne vaut 1 pour aucun bus : le champ semble non renseigné (le moteur traite alors tous les bus comme actifs, mode <code>Auto</code>).
        </div>
    }

    <div class="panel">
        <div class="form-grid compact">
            <label>Jour (lignes desservies, voyages)
                <input type="date" @bind="_usageDate" @bind:after="LoadUsageAsync" /></label>
            <label>Regrouper par
                <select @bind="_group">
                    <option value="@BusGroup.Category">Catégorie (type de bus)</option>
                    <option value="@BusGroup.Center">Centre (dépôt)</option>
                    <option value="@BusGroup.Delegation">Délégation</option>
                    <option value="@BusGroup.Line">Ligne (jour choisi)</option>
                    <option value="@BusGroup.AgeBand">Âge du bus</option>
                </select></label>
        </div>
        <div class="group-cards">
            @foreach (var g in groups)
            {
                <button class="group-card @(IsGroupActive(g) ? "active" : "")" @onclick="() => ApplyGroup(g)">
                    <span class="group-label">@g.Label</span>
                    <span class="group-count">@g.Count bus</span>
                    <span class="muted small">@g.Capacity places</span>
                </button>
            }
            @if (groups.Count == 0)
            {
                <span class="muted">Aucun groupe (aucun voyage affecté à un bus ce jour-là ?).</span>
            }
        </div>
    </div>

    <div class="panel">
        <div class="form-grid compact">
            <label>Recherche (plaque ou code)
                <input type="search" placeholder="ex. 4512 TU, 12…" @bind="_text" @bind:event="oninput" @bind:after="ResetPage" /></label>
            <label>Catégorie
                <select @bind="_categoryId" @bind:after="ResetPage">
                    <option value="">Toutes</option>
                    @foreach (var c in _categories) { <option value="@c.Id">@c.Label</option> }
                </select></label>
            <label>Centre (dépôt)
                <select @bind="_centerId" @bind:after="ResetPage">
                    <option value="">Tous</option>
                    @foreach (var c in _centers) { <option value="@c">Centre @c</option> }
                </select></label>
            <label>Délégation
                <select @bind="_delegationId" @bind:after="ResetPage">
                    <option value="">Toutes</option>
                    @foreach (var d in _delegations) { <option value="@d.Id">@d.Label</option> }
                </select></label>
            <label>Ligne (jour choisi)
                <select @bind="_lineId" @bind:after="ResetPage">
                    <option value="">Toutes</option>
                    @foreach (var l in _lines) { <option value="@l.Id">@l.Label</option> }
                </select></label>
            <label>Âge
                <select @bind="_ageBand" @bind:after="ResetPage">
                    <option value="">Tous</option>
                    @foreach (var band in AgeBands) { <option value="@band">@band</option> }
                </select></label>
            <label>Actif (DEACTIF)
                <select @bind="_active" @bind:after="ResetPage">
                    <option value="">Indifférent</option>
                    <option value="yes">Bus prêt = 0</option>
                    <option value="no">Bus non prêt = 1</option>
                </select></label>
        </div>
        <div class="toolbar">
            <button class="btn" @onclick="ResetFilters">Réinitialiser les filtres</button>
            <label class="inline">Lignes par page
                <select @bind="PageSize" @bind:after="ResetPage">
                    <option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option>
                </select></label>
        </div>
    </div>

    <table class="grid selectable">
        <thead>
            <tr>
                <th class="sortable" @onclick="() => SortBy(BusSort.Id)">Code @Arrow(BusSort.Id)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Plate)">Matricule @Arrow(BusSort.Plate)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Category)">Catégorie @Arrow(BusSort.Category)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Capacity)">Places (assises / debout) @Arrow(BusSort.Capacity)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Age)">Mise en circulation @Arrow(BusSort.Age)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Center)">Centre @Arrow(BusSort.Center)</th>
                <th class="sortable" @onclick="() => SortBy(BusSort.Delegation)">Délégation @Arrow(BusSort.Delegation)</th>
                <th>Lignes (jour)</th>
                <th>DEACTIF</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in rows)
            {
                <tr class="@(_selected?.Id == b.Id ? "selected" : "")" @onclick="() => SelectAsync(b)">
                    <td><code>@b.Id</code></td>
                    <td>@(b.Plate ?? "—")</td>
                    <td>@(b.CategoryLabel ?? "—") <span dir="rtl" class="muted small">@b.CategoryLabelAr</span></td>
                    <td>@b.Capacity <span class="muted small">(@b.Seats / @b.Standing)</span></td>
                    <td>@(b.InServiceSince?.ToString("MM/yyyy") ?? "—") <span class="muted small">@BusQuery.AgeBandOf(b.InServiceSince, now)</span></td>
                    <td>@(b.CenterId?.ToString() ?? "—")</td>
                    <td>@(b.DelegationLabel ?? b.DelegationId?.ToString() ?? "—")</td>
                    <td>@LinesOf(b.Id)</td>
                    <td>@(b.ActiveFlag?.ToString() ?? "—")</td>
                </tr>
            }
            @if (rows.Count == 0)
            {
                <tr><td colspan="9" class="muted">Aucun bus ne correspond aux filtres.</td></tr>
            }
        </tbody>
    </table>

    <div class="toolbar">
        <button class="btn" @onclick="() => _page = 1" disabled="@(_page <= 1)">⏮</button>
        <button class="btn" @onclick="() => _page--" disabled="@(_page <= 1)">◀</button>
        <span>Page @_page / @pageCount</span>
        <button class="btn" @onclick="() => _page++" disabled="@(_page >= pageCount)">▶</button>
        <button class="btn" @onclick="() => _page = pageCount" disabled="@(_page >= pageCount)">⏭</button>
    </div>

    @*
    @if (_selected is not null)
    {
        <div class="panel">
            <h2 style="margin-top:0">@(_selected.Plate ?? "Bus") <code>#@_selected.Id</code></h2>
            <p class="muted">
                @(_selected.CategoryLabel ?? "Sans catégorie") · @_selected.Capacity places ·
                Centre @(_selected.CenterId?.ToString() ?? "—") · Délégation @(_selected.DelegationLabel ?? "—") ·
                Mise en circulation : @(_selected.InServiceSince?.ToString("dd/MM/yyyy") ?? "—")
            </p>

            @if (_tripsError is not null)
            {
                <div class="alert error">@_tripsError</div>
            }
            else if (_trips is not null)
            {
                var km = _trips.Where(t => t.Arrival is not null).Sum(t => (t.Arrival!.Value - t.Departure).TotalHours);
                <p>Voyages du <strong>@_usageDate.ToString("dd/MM/yyyy")</strong> : <strong>@_trips.Count</strong> — environ <strong>@km.ToString("0.#", CultureInfo.InvariantCulture) h</strong> de service.</p>
                @if (_trips.Count > 0)
                {
