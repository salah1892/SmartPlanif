    *@
    <!-- Drawer overlay : fond sombre cliquable pour fermer -->
@if (_selected is not null)
{
    <div class="drawer-overlay" @onclick="CloseDrawer"></div>
}

<!-- Drawer latéral : panneau de détails du bus -->
@if (_selected is not null)
{
    <aside class="drawer">
        <div class="drawer-header">
            <div>
                <h2 style="margin:0">@(_selected.Plate ?? "Bus") <code>#@_selected.Id</code></h2>
                <span class="muted small">
                    @(_selected.CategoryLabel ?? "Sans catégorie") · @_selected.Capacity places
                </span>
            </div>
            <button class="drawer-close" @onclick="CloseDrawer" title="Fermer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="drawer-body">
            <p class="muted small">
                Centre @(_selected.CenterId?.ToString() ?? "—") · 
                Délégation @(_selected.DelegationLabel ?? "—") ·
                Mise en circulation : @(_selected.InServiceSince?.ToString("MM/yyyy") ?? "—")
                @if (_selected.InServiceSince is { } s) {
                    <span class="muted">(@BusQuery.AgeBandOf(s, DateTime.Today))</span>
                }
            </p>

            <div class="toolbar">
                <label class="inline">Voyages du jour
                    <input type="date" @bind="_usageDate" @bind:after="LoadTripsAsync" />
                </label>
            </div>

            @if (_tripsError is not null)
            {
                <div class="alert error">@_tripsError</div>
            }
            else if (_trips is not null)
            {
                var hours = _trips
                    .Where(t => t.Arrival is not null)
                    .Sum(t => (t.Arrival!.Value - t.Departure).TotalHours);

                <p class="small">
                    Voyages du <strong>@_usageDate.ToString("dd/MM/yyyy")</strong> : 
                    <strong>@_trips.Count</strong> — environ 
                    <strong>@hours.ToString("0.#", CultureInfo.InvariantCulture) h</strong> de service.
                </p>

                @if (_trips.Count > 0)
                {
                    <table class="grid">
                        <thead>
                            <tr>
                                <th>Départ</th>
                                <th>Arrivée</th>
                                <th>Ligne</th>
                                <th>Prévu</th>
                                <th>Réel</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _trips)
                            {
                                <tr>
                                    <td>@t.Departure.ToString("HH:mm")</td>
                                    <td>@(t.Arrival?.ToString("HH:mm") ?? "?")</td>
                                    <td>@t.LineLabel</td>
                                    <td>@(t.Planned ? "✔" : "—")</td>
                                    <td>@(t.Real ? "✔" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="muted small">Aucun voyage affecté à ce bus pour le jour choisi.</p>
                }
            }
        </div>
    </aside>
}
}

@code {
    private static readonly string[] AgeBands = { "0-5 ans", "5-10 ans", "10-15 ans", "15 ans et +", "Inconnu" };

    private IReadOnlyList<BusListItem> _all = Array.Empty<BusListItem>();
    private IReadOnlyList<(long Id, string Label)> _categories = Array.Empty<(long, string)>();
    private IReadOnlyList<long> _centers = Array.Empty<long>();
    private IReadOnlyList<(long Id, string Label)> _delegations = Array.Empty<(long, string)>();
    private IReadOnlyList<(long Id, string Label)> _lines = Array.Empty<(long, string)>();
    private IReadOnlyList<BusLineUsage> _usage = Array.Empty<BusLineUsage>();
    private ILookup<long, BusLineUsage> _usageByBus = Array.Empty<BusLineUsage>().ToLookup(u => u.BusId);
    private int _usageBusCount;
    private bool _loading = true;
    private string? _error;

    private string _text = "";
    private long? _categoryId;
    private long? _centerId;
    private long? _delegationId;
    private long? _lineId;
    private string _ageBand = "";
    private string _active = "";
    private BusGroup _group = BusGroup.Category;
    private BusSort _sort = BusSort.Plate;
    private bool _desc;
    private int _page = 1;
    public int PageSize { get; set; } = 25;

    private DateTime _usageDate;
    private BusListItem? _selected;
    private IReadOnlyList<BusTripRow>? _trips;
    private string? _tripsError;

    protected override async Task OnInitializedAsync()
    {
        _usageDate = Calendar.Today.ToDateTime(TimeOnly.MinValue);
        try
        {
            _all = await BusService.LoadAsync();
            _categories = _all.Where(b => b.CategoryId is not null)
                .GroupBy(b => b.CategoryId!.Value)
                .Select(g => (g.Key, g.First().CategoryLabel ?? $"Catégorie {g.Key}"))
                .OrderBy(x => x.Item2).ToList();
            _centers = _all.Where(b => b.CenterId is not null).Select(b => b.CenterId!.Value).Distinct().OrderBy(x => x).ToList();
            _delegations = _all.Where(b => b.DelegationId is not null)
                .GroupBy(b => b.DelegationId!.Value)
                .Select(g => (g.Key, g.First().DelegationLabel ?? $"Délégation {g.Key}"))
                .OrderBy(x => x.Item2).ToList();
            await LoadUsageAsync();
        }
        catch (Exception ex)
        {
            _error = "Chargement des bus impossible : " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Recharge les lignes desservies par bus pour le jour choisi (et le détail du bus sélectionné).</summary>
    private async Task LoadUsageAsync()
    {
        try
        {
            _usage = await BusService.GetLineUsageAsync(DateOnly.FromDateTime(_usageDate));
            _usageByBus = _usage.ToLookup(u => u.BusId);
            _usageBusCount = _usage.Select(u => u.BusId).Distinct().Count();
            _lines = _usage.GroupBy(u => u.LineId).Select(g => (g.Key, g.First().LineLabel)).OrderBy(x => x.Item2).ToList();
            if (_lineId is { } l && _lines.All(x => x.Id != l)) _lineId = null;
        }
        catch (Exception ex)
        {
            _error = "Lecture des lignes desservies impossible : " + ex.Message;
        }
        await LoadTripsAsync();
    }

    private BusFilter CurrentFilter()
    {
        IReadOnlySet<long>? onLine = _lineId is { } l
            ? _usage.Where(u => u.LineId == l).Select(u => u.BusId).ToHashSet()
            : null;
        return new BusFilter(_text, _categoryId, _centerId, _delegationId, string.IsNullOrEmpty(_ageBand) ? null : _ageBand,
            _active switch { "yes" => true, "no" => false, _ => null }, onLine);
    }

    private string LinesOf(long busId) =>
        string.Join(", ", _usageByBus[busId].Select(u => $"{u.LineLabel} ({u.Trips})"));

    private void ResetPage() => _page = 1;

    private void ResetFilters()
    {
        _text = ""; _categoryId = null; _centerId = null; _delegationId = null; _lineId = null; _ageBand = ""; _active = "";
        _page = 1;
    }

    private void SortBy(BusSort sort)
    {
        if (_sort == sort) _desc = !_desc; else { _sort = sort; _desc = false; }
        _page = 1;
    }

    private string Arrow(BusSort sort) => _sort != sort ? "" : _desc ? "▼" : "▲";

    /// <summary>Un clic sur une carte de groupe filtre la liste sur ce groupe (re-clic : retire le filtre).</summary>
    private void ApplyGroup(BusGroupSummary g)
    {
        var active = IsGroupActive(g);
        long? id = long.TryParse(g.Key, out var parsed) ? parsed : null;
        switch (_group)
        {
            case BusGroup.Category: _categoryId = active ? null : id; break;
            case BusGroup.Center: _centerId = active ? null : id; break;
            case BusGroup.Delegation: _delegationId = active ? null : id; break;
            case BusGroup.Line: _lineId = active ? null : id; break;
            default: _ageBand = active ? "" : g.Key; break;
        }
        _page = 1;
    }

    private bool IsGroupActive(BusGroupSummary g)
    {
        long? id = long.TryParse(g.Key, out var parsed) ? parsed : null;
        return _group switch
        {
            BusGroup.Category => _categoryId == id && id is not null,
            BusGroup.Center => _centerId == id && id is not null,
            BusGroup.Delegation => _delegationId == id && id is not null,
            BusGroup.Line => _lineId == id && id is not null,
            _ => _ageBand == g.Key,
        };
    }

    private async Task SelectAsync(BusListItem bus)
    {
        _selected = bus;
        await LoadTripsAsync();
    }

    private async Task LoadTripsAsync()
    {
        if (_selected is null) return;
        _tripsError = null;
        try
        {
            _trips = await BusService.GetTripsAsync(_selected.Id, DateOnly.FromDateTime(_usageDate));
        }
        catch (Exception ex)
        {
            _trips = null;
            _tripsError = "Lecture des voyages impossible : " + ex.Message;
        }
    }
    private void CloseDrawer()
    {
        _selected = null;
        _trips = null;
        _tripsError = null;
    }
}