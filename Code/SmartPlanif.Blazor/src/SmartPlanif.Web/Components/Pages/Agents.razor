@*     if (_page > pageCount) _page = pageCount; *@
@*     var rows = AgentQuery.Page(filtered, _page, PageSize); *@
@* *@
@*     <div class="kpis"> *@
@*         <div class="kpi"><span class="value">@_all.Count</span><span>agents au total</span></div> *@
@*         <div class="kpi"><span class="value">@filtered.Count</span><span>correspondent aux filtres</span></div> *@
@*         <div class="kpi"><span class="value">@_all.Count(a => a.Pda is > 0)</span><span>avec un PDA</span></div> *@
@*         <div class="kpi"><span class="value">@_all.Count(a => a.RestDay is null)</span><span>sans jour de repos valide</span></div> *@
@*     </div> *@
@* *@
@*     <div class="panel"> *@
@*         <div class="form-grid compact"> *@
@*             <label>Recherche (code, nom FR / AR) *@
@*                 <input type="search" placeholder="ex. 1042, Ben Ali, …" @bind="_text" @bind:event="oninput" @bind:after="ResetPage"/></label> *@
@*             <label>Centre *@
@*                 <select @bind="_centerId" @bind:after="ResetPage"> *@
@*                     <option value="">Tous</option> *@
@*                     @foreach (var c in _centers) *@
@*                     { *@
@*                         <option value="@c">Centre @c</option> *@
@*                     } *@
@*                 </select></label> *@
@*             <label>Délégation *@
@*                 <select @bind="_delegationId" @bind:after="ResetPage"> *@
@*                     <option value="">Toutes</option> *@
@*                     @foreach (var d in _delegations) *@
@*                     { *@
@*                         <option value="@d.Id">@d.Label</option> *@
@*                     } *@
@*                 </select></label> *@
@*             <label>Jour de repos *@
@*                 <select @bind="_restDay" @bind:after="ResetPage"> *@
@*                     <option value="">Tous</option> *@
@*                     @for (var i = 1; i <= 7; i++) *@
@*                     { *@
@*                         <option value="@i">@DayName(i)</option> *@
@*                     } *@
@*                 </select></label> *@
@*             <label>Qualification (DECQUAL) *@
@*                 <select @bind="_qual" @bind:after="ResetPage"> *@
@*                     <option value="">Toutes</option> *@
@*                     @foreach (var q in _quals) *@
@*                     { *@
@*                         <option value="@q">@q</option> *@
@*                     } *@
@*                 </select></label> *@
@*             <label>PDA *@
@*                 <select @bind="_pda" @bind:after="ResetPage"> *@
@*                     <option value="">Indifférent</option> *@
@*                     <option value="yes">Avec PDA</option> *@
@*                     <option value="no">Sans PDA</option> *@
@*                 </select></label> *@
@*         </div> *@
@*         <div class="toolbar"> *@
@*             <button class="btn" @onclick="ResetFilters">Réinitialiser les filtres</button> *@
@*             <label class="inline">Lignes par page *@
@*                 <select @bind="PageSize" @bind:after="ResetPage"> *@
@*                     <option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option> *@
@*                 </select></label> *@
@*         </div> *@
@*     </div> *@
@* *@
@*     <table class="grid selectable"> *@
@*         <thead> *@
@*         <tr> *@
@*             <th class="sortable" @onclick="() => SortBy(AgentSort.Id)">Code @Arrow(AgentSort.Id)</th> *@
@*             <th class="sortable" @onclick="() => SortBy(AgentSort.Name)">Nom @Arrow(AgentSort.Name)</th> *@
@*             <th>الاسم</th> *@
@*             <th>Qualif.</th> *@
@*             <th class="sortable" @onclick="() => SortBy(AgentSort.Center)">Centre @Arrow(AgentSort.Center)</th> *@
@*             <th class="sortable" @onclick="() => SortBy(AgentSort.Delegation)">Délégation @Arrow(AgentSort.Delegation)</th> *@
@*             <th class="sortable" @onclick="() => SortBy(AgentSort.RestDay)">Repos @Arrow(AgentSort.RestDay)</th> *@
@*             <th>PDA</th> *@
@*         </tr> *@
@*         </thead> *@
@*         <tbody> *@
@*         @foreach (var a in rows) *@
@*         { *@
@*             <tr class="@(_selected?.Id == a.Id ? "selected" : "")" @onclick="() => SelectAsync(a)"> *@
@*                 <td><code>@a.Id</code></td> *@
@*                 <td>@(a.NameFr ?? "—")</td> *@
@*                 <td dir="rtl">@(a.NameAr ?? "")</td> *@
@*                 <td>@(a.Qualification ?? "—")</td> *@
@*                 <td>@(a.CenterId?.ToString() ?? "—")</td> *@
@*                 <td>@(a.DelegationLabel ?? a.DelegationId?.ToString() ?? "—")</td> *@
@*                 <td>@(a.RestDay is { } r ? DayName(r) : "—")</td> *@
@*                 <td>@(a.Pda is > 0 ? a.Pda.ToString() : "—")</td> *@
@*             </tr> *@
@*         } *@
@*         @if (rows.Count == 0) *@
@*         { *@
@*             <tr><td colspan="8" class="muted">Aucun agent ne correspond aux filtres.</td></tr> *@
@*         } *@
@*         </tbody> *@
@*     </table> *@
@* *@
@*     <div class="toolbar"> *@
@*         <button class="btn" @onclick="() => _page = 1" disabled="@(_page <= 1)">⏮</button> *@
@*         <button class="btn" @onclick="() => _page--" disabled="@(_page <= 1)">◀</button> *@
@*         <span>Page @_page / @pageCount</span> *@
@*         <button class="btn" @onclick="() => _page++" disabled="@(_page >= pageCount)">▶</button> *@
@*         <button class="btn" @onclick="() => _page = pageCount" disabled="@(_page >= pageCount)">⏭</button> *@
@*     </div> *@
@*      *@
@*     <!-- Drawer overlay : fond sombre cliquable pour fermer --> *@
@*     @if (_selected is not null) *@
@*     { *@
@*         <div class="drawer-overlay" @onclick="CloseDrawer"></div> *@
@*     } *@
@* *@
@*     <!-- Drawer latéral : panneau de détails --> *@
@*     @if (_selected is not null) *@
@*     { *@
@*         <aside class="drawer"> *@
@*             <div class="drawer-header"> *@
@*                 <div> *@
@*                     <h2 style="margin:0">@(_selected.NameFr ?? "Agent") <code>#@_selected.Id</code></h2> *@
@*                     <span dir="rtl" class="muted small">@_selected.NameAr</span> *@
@*                 </div> *@
@*                 <button class="drawer-close" @onclick="CloseDrawer" title="Fermer"> *@
@*                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> *@
@*                         <line x1="18" y1="6" x2="6" y2="18"></line> *@
@*                         <line x1="6" y1="6" x2="18" y2="18"></line> *@
@*                     </svg> *@
@*                 </button> *@
@*             </div> *@
@* *@
@*             <div class="drawer-body"> *@
@*                 <p class="muted small"> *@
@*                     Centre @(_selected.CenterId?.ToString() ?? "—") · *@
@*                     Délégation @(_selected.DelegationLabel ?? "—") · *@
@*                     Repos : @(_selected.RestDay is { } rd ? DayName(rd) : "—") *@
@*                 </p> *@
@* *@
@*                 <div class="toolbar"> *@
@*                     <label class="inline">Voyages du jour *@
@*                         <input type="date" @bind="_tripDate" @bind:after="LoadTripsAsync"/> *@
@*                     </label> *@
@*                 </div> *@
@* *@
@*                 @if (_tripsError is not null) *@
@*                 { *@
@*                     <div class="alert error">@_tripsError</div> *@
@*                 } *@
@*                 else if (_trips is not null) *@
@*                 { *@
@*                     var hours = _trips *@
@*                         .Where(t => t.Arrival is not null && (t.Planned != AgentPost.None || t.Real != AgentPost.None)) *@
@*                         .Sum(t => (t.Arrival!.Value - t.Departure).TotalHours); *@
@* *@
@*                     <p class="small"> *@
@*                         <strong>@_trips.Count</strong> voyage(s) — environ <strong>@hours.ToString("0.#", CultureInfo.InvariantCulture) h</strong> de conduite/contrôle. *@
@*                     </p> *@
@* *@
@*                     @if (_trips.Count > 0) *@
@*                     { *@
@*                         <table class="grid"> *@
@*                             <thead> *@
@*                             <tr> *@
@*                                 <th>Départ</th> *@
@*                                 <th>Arrivée</th> *@
@*                                 <th>Ligne</th> *@
@*                                 <th>Poste prévu</th> *@
@*                                 <th>Poste réel</th> *@
@*                             </tr> *@
@*                             </thead> *@
@*                             <tbody> *@
@*                             @foreach (var t in _trips) *@
@*                             { *@
@*                                 <tr> *@
@*                                     <td>@t.Departure.ToString("HH:mm")</td> *@
@*                                     <td>@(t.Arrival?.ToString("HH:mm") ?? "?")</td> *@
@*                                     <td>@t.LineLabel</td> *@
@*                                     <td>@PostLabel(t.Planned)</td> *@
@*                                     <td>@PostLabel(t.Real)</td> *@
@*                                 </tr> *@
@*                             } *@
@*                             </tbody> *@
@*                         </table> *@
@*                     } *@
@*                 } *@
@*             </div> *@
@*         </aside> *@
@*     } *@
@* } *@
@* *@
@* @code { *@
@*     private const int DefaultPageSize = 25; *@
@* *@
@*     private IReadOnlyList<AgentListItem> _all = Array.Empty<AgentListItem>(); *@
@*     private IReadOnlyList<long> _centers = Array.Empty<long>(); *@
@*     private IReadOnlyList<(long Id, string Label)> _delegations = Array.Empty<(long, string)>(); *@
@*     private IReadOnlyList<string> _quals = Array.Empty<string>(); *@
@*     private bool _loading = true; *@
@*     private string? _error; *@
@* *@
@*     private string _text = ""; *@
@*     private long? _centerId; *@
@*     private long? _delegationId; *@
@*     private int? _restDay; *@
@*     private string _qual = ""; *@
@*     private string _pda = ""; *@
@*     private AgentSort _sort = AgentSort.Name; *@
@*     private bool _desc; *@
@*     private int _page = 1; *@
@*     public int PageSize { get; set; } = DefaultPageSize; *@
@* *@
@*     private AgentListItem? _selected; *@
@*     private DateTime _tripDate; *@
@*     private IReadOnlyList<AgentTripRow>? _trips; *@
@*     private string? _tripsError; *@
@* *@
@*     protected override async Task OnInitializedAsync() *@
@*     { *@
@*         _tripDate = Calendar.Today.ToDateTime(TimeOnly.MinValue); *@
@*         try *@
@*         { *@
@*             _all = await AgentService.LoadAsync(); *@
@*             _centers = _all.Where(a => a.CenterId is not null).Select(a => a.CenterId!.Value).Distinct().OrderBy(x => x).ToList(); *@
@*             _delegations = _all.Where(a => a.DelegationId is not null) *@
@*                 .GroupBy(a => a.DelegationId!.Value) *@
@*                 .Select(g => (g.Key, g.First().DelegationLabel ?? $"Délégation {g.Key}")) *@
@*                 .OrderBy(x => x.Item2).ToList(); *@
@*             _quals = _all.Select(a => a.Qualification).Where(q => !string.IsNullOrEmpty(q)).Select(q => q!).Distinct().OrderBy(q => q).ToList(); *@
@*         } *@
@*         catch (Exception ex) *@
@*         { *@
@*             _error = "Chargement des agents impossible : " + ex.Message; *@
@*         } *@
@*         finally *@
@*         { *@
@*             _loading = false; *@
@*         } *@
@*     } *@
@* *@
@*     private AgentFilter CurrentFilter() => new( *@
@*         _text, _centerId, _delegationId, _restDay, _qual, *@
@*         _pda switch { "yes" => true, "no" => false, _ => null }); *@
@* *@
@*     private void ResetPage() => _page = 1; *@
@* *@
@*     private void ResetFilters() *@
@*     { *@
@*         _text = ""; _centerId = null; _delegationId = null; _restDay = null; _qual = ""; _pda = ""; *@
@*         _page = 1; *@
@*     } *@
@* *@
@*     private void SortBy(AgentSort sort) *@
@*     { *@
@*         if (_sort == sort) _desc = !_desc; else { _sort = sort; _desc = false; } *@
@*         _page = 1; *@
@*     } *@
@* *@
@*     private string Arrow(AgentSort sort) => _sort != sort ? "" : _desc ? "▼" : "▲"; *@
@* *@
@*     private async Task SelectAsync(AgentListItem agent) *@
@*     { *@
@*         _selected = agent; *@
@*         await LoadTripsAsync(); *@
@*     } *@
@* *@
@*     private async Task LoadTripsAsync() *@
@*     { *@
@*         if (_selected is null) return; *@
@*         _tripsError = null; *@
@*         try *@
@*         { *@
@*             _trips = await AgentService.GetTripsAsync(_selected.Id, DateOnly.FromDateTime(_tripDate)); *@
@*         } *@
@*         catch (Exception ex) *@
@*         { *@
@*             _trips = null; *@
@*             _tripsError = "Lecture des voyages impossible : " + ex.Message; *@
@*         } *@
@*     } *@
@* *@
@*     private static string DayName(int day) => day switch *@
@*     { *@
@*         1 => "Lundi", 2 => "Mardi", 3 => "Mercredi", 4 => "Jeudi", 5 => "Vendredi", 6 => "Samedi", 7 => "Dimanche", _ => "—", *@
@*     }; *@
@* *@
@*     private static string PostLabel(AgentPost post) => post switch *@
@*     { *@
@*         AgentPost.Driver => "Chauffeur", *@
@*         AgentPost.Receiver => "Receveur", *@
@*         _ => "—", *@
@*     }; *@
@*     private void CloseDrawer() *@
@*     { *@
@*         _selected = null; *@
@*         _trips = null; *@
@*         _tripsError = null; *@
@*     } *@
@* } *@