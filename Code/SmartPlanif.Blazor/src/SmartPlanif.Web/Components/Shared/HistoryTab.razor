@using System.Globalization
@inject HistoryService History
@inject PlanningCalendar Calendar

<p class="muted">
    Historique de toutes les journées <strong>jusqu'à hier</strong> (@YesterdayText).
    Le plan « effectif » d'un voyage = ressources réelles (<code>*_RE</code>) si elles sont renseignées,
    sinon ressources prévues (<code>*_PR</code>).
    Cliquez sur une légende pour masquer une courbe ; survolez un graphique pour lire les valeurs.
</p>

<div class="panel">
    <div class="form-grid compact">
        <label>Du
            <input type="date" @bind="_from" @bind:after="LoadAsync" max="@YesterdayText" /></label>
        <label>Au (hier au plus tard)
            <input type="date" @bind="_to" @bind:after="LoadAsync" max="@YesterdayText" /></label>
        <label>Regroupement des points
            <select @bind="_granularity" @bind:after="LoadAsync">
                <option value="@HistoryGranularity.Auto">Automatique</option>
                <option value="@HistoryGranularity.Day">Par jour</option>
                <option value="@HistoryGranularity.Week">Par semaine</option>
                <option value="@HistoryGranularity.Month">Par mois</option>
            </select></label>
        <label>« À l'heure » : retard toléré (min)
            <input type="number" min="0" step="1" @bind="_onTimeMinutes" @bind:after="LoadAsync" /></label>
    </div>
    <div class="toolbar">
        <button class="btn" @onclick="() => SetPresetAsync(30)">30 derniers jours</button>
        <button class="btn" @onclick="() => SetPresetAsync(90)">90 jours</button>
        <button class="btn" @onclick="() => SetPresetAsync(365)">1 an</button>
        <button class="btn" @onclick="() => SetPresetAsync(null)">Tout l'historique</button>
        <button class="btn primary" @onclick="LoadAsync" disabled="@_loading">Actualiser</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert error">@_error</div>
}
else if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Chargement de l'historique…</p>
    </div>
}
else if (_report is null)
{
    <div class="alert warn">
        Aucune donnée disponible. Vérifiez que la table <code>trips</code> contient des voyages sur la période sélectionnée.
    </div>
}
else
{
    var t = _report.Total;
    if (t.Trips == 0)
    {
        <div class="alert warn">Aucun voyage dans la table <code>trips</code> sur cette période.</div>
    }
    else
    {
        <p class="muted small">
            Période réellement couverte : <strong>@_report.From.ToString("dd/MM/yyyy") → @_report.To.ToString("dd/MM/yyyy")</strong>
            · points par <strong>@GranularityLabel(_report.Granularity)</strong>
            · @_report.ActiveBuses bus actifs · @_report.PlannableAgents agents planifiables.
        </p>
        <div class="kpis">
            <div class="kpi"><span class="value">@t.Trips</span><span>voyages sur @t.DaysWithTrips jour(s)</span></div>
            <div class="kpi @Cls(t.CoverageRate, 99, 90)"><span class="value">@Pct(t.CoverageRate)</span><span>couverture (plan ou réel complet)</span></div>
            <div class="kpi"><span class="value">@Pct(t.RealizedRate)</span><span>voyages effectués (réel complet)</span></div>
            <div class="kpi"><span class="value">@Pct(t.BusUtilization)</span><span>bus utilisés par jour (moyenne)</span></div>
            <div class="kpi"><span class="value">@Pct(t.AgentUtilization)</span><span>agents utilisés par jour (moyenne)</span></div>
            <div class="kpi @Cls(t.OnTimeRate, 90, 75)"><span class="value">@Pct(t.OnTimeRate)</span><span>voyages à l'heure</span></div>
            <div class="kpi"><span class="value">@(t.AvgDelayMinutes is { } dm ? Num(dm) + " min" : "—")</span><span>retard moyen (&gt; 0 = retard)</span></div>
            <div class="kpi"><span class="value">@Pct(t.ChangeRate)</span><span>changements prévu → réel</span></div>
        </div>
        <h3>Qualité de la planification</h3>
        <div class="chart-grid">
            <TrendChart Title="Couverture et exécution (%)" Labels="_labels" Series="_coverageSeries" YMax="100" />
            <TrendChart Title="Utilisation des ressources par jour (%)" Labels="_labels" Series="_usageSeries" YMax="100" />
            <TrendChart Title="Ponctualité et stabilité du plan (%)" Labels="_labels" Series="_execSeries" YMax="100" />
            <TrendChart Title="Retard moyen (minutes)" Labels="_labels" Series="_delaySeries" />
            <TrendChart Title="Volume de voyages" Labels="_labels" Series="_volumeSeries" Bars="true" />
        </div>
        <h3>Équité de l'utilisation des ressources (période entière)</h3>
        <table class="grid">
            <thead>
                <tr><th>Indicateur</th><th>Ressources</th><th>Jamais utilisées</th><th>Moyenne</th><th>Min</th><th>Max</th><th>Écart-type</th><th>CV</th><th>Jain</th><th>Verdict</th></tr>
            </thead>
            <tbody>
                @foreach (var s in new[] { _report.BusDistribution, _report.AgentDistribution })
                {
                    <tr>
                        <td>@s.Name</td><td>@s.Count</td><td>@s.Unused</td>
                        <td>@Num(s.Mean)</td><td>@Num(s.Min)</td><td>@Num(s.Max)</td><td>@Num(s.StdDev)</td>
                        <td>@s.Cv.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td>@s.Jain.ToString("0.00", CultureInfo.InvariantCulture)</td>
                        <td><span class="badge @(s.Css == "ok" ? "soft" : s.Css == "warn" ? "off" : "hard")">@s.Verdict</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted small">Jain : 1 = parfaitement égal. CV (écart-type / moyenne) : plus il est bas, plus l'usage est équitable.</p>
        <h3>Historique d'utilisation des ressources</h3>
        <div class="toolbar">
            <button class="btn @(_mode == "bus" ? "primary" : "")" @onclick='() => SetModeAsync("bus")'>Bus</button>
            <button class="btn @(_mode == "agent" ? "primary" : "")" @onclick='() => SetModeAsync("agent")'>Agents</button>
            <span class="spacer"></span>
            <button class="btn @(_sort == "top" ? "primary" : "")" @onclick='() => _sort = "top"'>Les plus utilisés</button>
            <button class="btn @(_sort == "bottom" ? "primary" : "")" @onclick='() => _sort = "bottom"'>Les moins utilisés</button>
            <input type="search" placeholder="Filtrer (plaque, nom, code)…" @bind="_search" @bind:event="oninput" />
            <label class="inline">Afficher
                <select @bind="_top">
                    <option value="10">10</option><option value="15">15</option><option value="30">30</option><option value="50">50</option><option value="200">200</option>
                </select></label>
        </div>
        <div class="hist-grid">
            <div>
                <p class="muted small">
                    @(_mode == "bus" ? "Voyages par bus" : "Postes tenus par agent (chauffeur + receveur)") sur la période.
                    Cliquez sur une ligne pour voir son historique.
                </p>
                <UsageBars Items="CurrentUsage()" Top="_top" Selected="_selectedId" OnSelect="SelectAsync" />
            </div>
            <div>
                @if (_selectedId is null)
                {
                    <p class="muted">Sélectionnez une ressource à gauche pour afficher son historique jour par jour.</p>
                }
                else
                {
                    <TrendChart Title="@($"Historique de {_selectedLabel} (voyages par {GranularityLabel(_report.Granularity)})")"
                                Labels="_resLabels" Series="_resSeries" Bars="true" />
                }
            </div>
        </div>
    }
}

<style>
.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    color: #64748b;
    font-family: system-ui, -apple-system, sans-serif;
}

.loading-state .spinner {
    width: 50px;
    height: 50px;
    border: 3px solid #e2e8f0;
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 1rem;
}

@@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-state p {
    margin: 0;
    font-size: 0.95rem;
}
</style>

@code {
    private DateTime _from;
    private DateTime _to;
    private HistoryGranularity _granularity = HistoryGranularity.Auto;
    private int _onTimeMinutes = 5;
    private bool _loading = true;
    private string? _error;
    private HistoryReport? _report;
    private IReadOnlyList<string> _labels = Array.Empty<string>();
    private IReadOnlyList<ChartSeries> _coverageSeries = Array.Empty<ChartSeries>();
    private IReadOnlyList<ChartSeries> _usageSeries = Array.Empty<ChartSeries>();
    private IReadOnlyList<ChartSeries> _execSeries = Array.Empty<ChartSeries>();
    private IReadOnlyList<ChartSeries> _delaySeries = Array.Empty<ChartSeries>();
    private IReadOnlyList<ChartSeries> _volumeSeries = Array.Empty<ChartSeries>();
    private string _mode = "bus";
    private string _sort = "top";
    private string _search = "";
    private int _top = 15;
    private long? _selectedId;
    private string _selectedLabel = "";
    private IReadOnlyList<string> _resLabels = Array.Empty<string>();
    private IReadOnlyList<ChartSeries> _resSeries = Array.Empty<ChartSeries>();

    private DateOnly Yesterday => Calendar.Today.AddDays(-1);
    private string YesterdayText => Yesterday.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _to = Yesterday.ToDateTime(TimeOnly.MinValue);
        _from = _to.AddDays(-29);
        await LoadAsync();
    }

    private async Task SetPresetAsync(int? days)
    {
        _to = Yesterday.ToDateTime(TimeOnly.MinValue);
        _from = days is { } d ? _to.AddDays(-(d - 1)) : new DateTime(2000, 1, 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _report = null;
        StateHasChanged();//← Force le rendu pour afficher le spinner

        try
        {
            var report = await History.GetAsync(
                DateOnly.FromDateTime(_from),
                DateOnly.FromDateTime(_to),
                Math.Max(0, _onTimeMinutes) * 60,
                _granularity);
            if (report is null)
            {
                _error = "Le service n'a retourné aucune donnée. Vérifiez la connexion à la base.";
            }
            else
            {
                _report = report;
                _from = report.From.ToDateTime(TimeOnly.MinValue);
                _to = report.To.ToDateTime(TimeOnly.MinValue);
                BuildCharts(report);

                var list = _mode == "bus" ? report.Buses : report.Agents;
                if (_selectedId is { } id && list.All(u => u.Id != id))
                    _selectedId = null;

                await LoadResourceAsync();
            }
        }
        catch (Exception ex)
        {
            _error = "Lecture de l'historique impossible : " + ex.Message;
            _report = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();   //← Force le rendu final
        }
    }

    private void BuildCharts(HistoryReport r)
    {
        IReadOnlyList<double?> V(Func<QualityPoint, double?> f) => r.Points.Select(f).ToList();
        _labels = r.Points.Select(p => p.Label).ToList();
        _coverageSeries = new[]
        {
            new ChartSeries("Couverture (plan ou réel complet)", "#1f6f8b", V(p => p.CoverageRate), " %"),
            new ChartSeries("Voyages effectués (réel complet)", "#2e7d4f", V(p => p.RealizedRate), " %"),
        };
        _usageSeries = new[]
        {
            new ChartSeries("Bus utilisés", "#b8860b", V(p => p.BusUtilization), " %"),
            new ChartSeries("Agents utilisés", "#7b4fa3", V(p => p.AgentUtilization), " %"),
        };
        _execSeries = new[]
        {
            new ChartSeries("À l'heure", "#2e7d4f", V(p => p.OnTimeRate), " %"),
            new ChartSeries("Changements prévu → réel", "#b03a2e", V(p => p.ChangeRate), " %"),
        };
        _delaySeries = new[] { new ChartSeries("Retard moyen", "#d9776b", V(p => p.AvgDelayMinutes), " min") };
        _volumeSeries = new[] { new ChartSeries("Voyages", "#1f4e79", V(p => (double?)p.Trips), "") };
    }

    private async Task SetModeAsync(string mode)
    {
        _mode = mode;
        _selectedId = null;
        _search = "";
        _resLabels = Array.Empty<string>();
        _resSeries = Array.Empty<ChartSeries>();
        await Task.CompletedTask;
    }

    private IReadOnlyList<ResourceUsage> CurrentUsage()
    {
        var q = (_mode == "bus" ? _report!.Buses : _report!.Agents).AsEnumerable();
        var text = _search.Trim();
        if (text.Length > 0)
            q = q.Where(u => u.Label.Contains(text, StringComparison.OrdinalIgnoreCase) || u.Id.ToString() == text);
        q = _sort == "top"
            ? q.OrderByDescending(u => u.Trips).ThenBy(u => u.Label)
            : q.OrderBy(u => u.Trips).ThenBy(u => u.Label);
        return q.ToList();
    }

    private async Task SelectAsync(long id)
    {
        _selectedId = id;
        await LoadResourceAsync();
    }

    private async Task LoadResourceAsync()
    {
        if (_selectedId is not { } id || _report is null) return;
        try
        {
            var usage = (_mode == "bus" ? _report.Buses : _report.Agents).First(u => u.Id == id);
            _selectedLabel = usage.Label;
            var rows = await History.GetResourceDailyAsync(_mode == "bus", id, _report.From, _report.To);
            var (labels, values) = HistoryMath.ResourceSeries(rows, _report.From, _report.To, _report.Granularity);
            _resLabels = labels;
            _resSeries = new[] { new ChartSeries(usage.Label, "#1f6f8b", values, " voyage(s)") };
        }
        catch (Exception ex)
        {
            _error = "Lecture de l'historique de la ressource impossible : " + ex.Message;
        }
    }

    private static string GranularityLabel(HistoryGranularity g) => g switch
    {
        HistoryGranularity.Week => "semaine",
        HistoryGranularity.Month => "mois",
        _ => "jour",
    };

    private static string Cls(double? v, double good, double bad) =>
        v is not { } x ? "" : x >= good ? "good" : x < bad ? "bad" : "";

    private static string Pct(double? v) => v is { } x ? x.ToString("0.#", CultureInfo.InvariantCulture) + " %" : "—";

    private static string Num(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}