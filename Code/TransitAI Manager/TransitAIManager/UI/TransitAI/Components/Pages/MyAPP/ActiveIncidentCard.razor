<MudCard Outlined="true" Style="border-left: 4px solid var(--mud-palette-error);">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.overline" Color="Color.Error">Active Incident • LIVE</MudText>
            <MudText Typo="Typo.h6">Vehicle V1 Breakdown</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2">Stop S2 • Route 42A • Reported 4 mins ago</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">Passengers affected: <b>23</b></MudText>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Dispatch V2</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="ml-2">Notify Passengers</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public string? Class { get; set; }
}