    };

    // --- Données pour les filtres ---
    private string searchString = "";
    private DateTime? serviceDate = DateTime.Today;
    
    // Variables pour les MudSelect (corrige les erreurs de compilation)
    private string selectedSession = "Toutes les sessions";
    private string selectedAffectation = "Tous les trajets";
    private string selectedLigne = "Tout";
    private string selectedCentre = "Tout";
