@* =============================================== KPI Cards =============================================== *@
@* <MudGrid Class="px-0" Spacing="4" Style="overflow-y: auto;"> *@
<MudGrid Spacing="4" Style="overflow-y: auto;">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="d-flex align-center pa-2" Elevation="0" Outlined="true" Style="border-radius: 8px; background-color: white;">
            <MudAvatar Rounded="true" Style="width: 36px; height: 36px; background-color: #1976d2; margin-right: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBus" Color="Color.Surface" Size="Size.Medium" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #333;">9000</MudText>
                <MudText Typo="Typo.caption" Style="color: #757575;">Lignes au réseau</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="d-flex align-center pa-2" Elevation="0" Outlined="true" Style="border-radius: 8px; background-color: white;">
            <MudAvatar Rounded="true" Style="width: 36px; height: 36px; background-color: #388e3c; margin-right: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Surface" Size="Size.Medium" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #333;">164</MudText>
                <MudText Typo="Typo.caption" Style="color: #757575;">Horaires publiés (échantillon)</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="d-flex align-center pa-2" Elevation="0" Outlined="true" Style="border-radius: 8px; background-color: white;">
            <MudAvatar Rounded="true" Style="width: 36px; height: 36px; background-color: #f57c00; margin-right: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Surface" Size="Size.Medium" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #333;">76</MudText>
                <MudText Typo="Typo.caption" Style="color: #757575;">En attente de publication</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="d-flex align-center pa-2" Elevation="0" Outlined="true" Style="border-radius: 8px; background-color: white;">
            <MudAvatar Rounded="true" Style="width: 36px; height: 36px; background-color: #7b1fa2; margin-right: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Surface" Size="Size.Medium" />
            </MudAvatar>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #333;">20 000</MudText>
                <MudText Typo="Typo.caption" Style="color: #757575;">Stations (drstati)</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@* =============================================== Toolbar =============================================== *@
<MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-4 mx-1" Style="border-radius: 8px; background-color: white;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-nowrap">

        <!-- Recherche -->
        <MudTextField T="string"
                      @bind-Value="_searchBase"
                      Placeholder="Rechercher par numéro ou nom de ligne..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Default"
                      Immediate="true"
                      Margin="Margin.Dense"
                      Class="flex-1"
                      Style="min-width: 220px; max-width: 320px; border-radius: 8px;font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" />

        <!-- Délégation -->
        <MudSelect T="string"
                   @bind-Value="_delegation"
                   ToStringFunc="@GetDelegationLabel"
                   Variant="Variant.Outlined"
                   Adornment="Adornment.End"
                   AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown"
                   Margin="Margin.Dense"
                   Dense="true"
                   Class="custom-select"
                   Style="min-width: 200px; border-radius: 8px;">

            <!-- Option par défaut -->
            <MudSelectItem Value="@("Toutes")">Toutes délégations</MudSelectItem>

            <!-- Boucle dynamique sur vos données de la BDD -->
            @foreach (var item in _delegations)
            {
                <MudSelectItem Value="@item.IdDelegation.ToString()" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
                    @item.NameDelegFr
                </MudSelectItem>
            }
        </MudSelect>
        <!-- Type -->
        <MudSelect T="string"
                   @bind-Value="_type"
                   Variant="Variant.Outlined"
                   Adornment="Adornment.End"
                   AdornmentIcon="@Icons.Material.Filled.KeyboardArrowDown"
                   AdornmentColor="Color.Default"
                   Margin="Margin.Dense"
                   Dense="true"
                   Style="min-width: 200px; border-radius: 8px;font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
            <MudSelectItem Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" Value="@("Tous")">Tous types</MudSelectItem>
            <MudSelectItem Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" Value="@("Interurbain")">Interurbain</MudSelectItem>
            <MudSelectItem Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" Value="@("Urbaine")">Urbaine</MudSelectItem>
            <MudSelectItem Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" Value="@("Scolaire")">Scolaire</MudSelectItem>
            <MudSelectItem Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;" Value="@("Nocturne")">Nocturne</MudSelectItem>
        </MudSelect>

        <!-- Résultats -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-none">
            <MudIcon Icon="@Icons.Material.Outlined.FilterAlt"
                     Size="Size.Small"
                     Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                240 résultats
            </MudText>
        </MudStack>

        <MudSpacer />

        <!-- Bouton Générateur d'Horaires -->
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.AutoFixHigh"
                   Style="height: 40px; border-radius: 8px; text-transform: none; font-weight: 500; font-size: 0.875rem; white-space: nowrap;">
            Générateur d'Horaires
        </MudButton>

        <!-- Bouton Publier le Planning -->
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Publish"
                   Style="height: 40px; border-radius: 8px; text-transform: none; font-weight: 500; font-size: 0.875rem; white-space: nowrap;">
            Publier le Planning
        </MudButton>

    </MudStack>
</MudPaper>
