@* =============================================== Table =============================================== *@

<MudTable Items="@_Depart" Dense="true" Hover="true" Bordered="false" Striped="false" Fixed="true"
          Class="mb-4" Elevation="0" Outlined="true" RowsPerPage="50" Style="border-radius: 8px; background-color: white;">
    <HeaderContent>
        <MudTh Style="width: 30px;"><MudCheckBox T="bool" Dense="true" /></MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">N° LIGNE</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">NOM</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">DÉLÉGATION</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">TYPE</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">DÉPART</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">ARRIVÉE</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">FRÉQ.</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">JOURS</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">VÉHICULES</MudTh>
        <MudTh Style="font-weight: 600;font-size: 11px; color: #64748B;">STATUT</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><MudCheckBox T="bool" Dense="true" /></MudTd>
        <MudTd DataLabel="N° LIGNE" Style="padding: 8px 12px; vertical-align: middle; width: 92.825px; height: 36.8px;">
            <MudText Typo="Typo.body2" Style="font-weight: 700; font-size: 12px; color: #0F1729; line-height: 16px; font-family: 'Inter', sans-serif;">
                @context.drLigne?.Denumli
                </MudText>
        </MudTd>
        <MudTd DataLabel="NOM">
            <MudText Typo="Typo.body2" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #0F1729; word-spacing: 0px;">
                @context.drLigne?.Denomla
                </MudText>
        </MudTd>
        <MudTd DataLabel="DÉLÉGATION">
            <MudText Typo="Typo.body2" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
                @context.drLigne?.Decdeleg</MudText>
        </MudTd>
        <MudTd DataLabel="TYPE">
            @{
                var (bg, fg) = context.drLigne?.Dectyli switch
                {
                    // "Interurbain" => ("#f3e5f5", "#7b1fa2"),
                    // "Scolaire" => ("#fff3e0", "#e65100"),
                    // "Urbaine" => ("#e3f2fd", "#1565c0"),
                    // "Nocturne" => ("#eceff1", "#455a64"),
                    1 => ("#f3e5f5", "#7b1fa2"),
                    2 => ("#fff3e0", "#e65100"),
                    3 => ("#e3f2fd", "#1565c0"),
                    4 => ("#eceff1", "#455a64"),
                    _ => ("#f5f5f5", "#333")
                };
            }
            <MudChip T="string" Size="Size.Small" Label="true" Style="@($"background-color: {bg}; color: {fg}; border-radius: 12px; font-weight: 500;")">
                @context.drLigne?.Dectyli
            </MudChip>
        </MudTd>
        @* <MudTd DataLabel="DÉPART">@context.Depart</MudTd> *@
        <MudTd DataLabel="DÉPART">
            <MudText Typo="Typo.body2" Style="font-family: 'Menlo', monospace; font-size: 12px; line-height: 16px; color: #0F1729; word-spacing: 0px;">
                @context.DEDATED
                </MudText>
        </MudTd>
        <MudTd DataLabel="ARRIVÉE">
            <MudText Typo="Typo.body2" Style="font-family: 'Menlo', monospace; font-size: 12px; line-height: 16px; color: #0F1729; word-spacing: 0px;">
                @context.DEHEUAA
                </MudText>
        </MudTd>
        @* <MudTd DataLabel="FRÉQ.">@context.Frequence</MudTd> *@
        <MudTd DataLabel="FRÉQ.">
            <MudText Typo="Typo.body2" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
                @context.DEHEUFS
                </MudText>
        </MudTd>
        @* <MudTd DataLabel="JOURS">@context.Jours</MudTd> *@
        <MudTd DataLabel="JOURS.">
            <MudText Typo="Typo.body2" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
                @context.DEKMTH
                </MudText>
        </MudTd>
        @* <MudTd DataLabel="VÉHICULES">@context.Vehicules</MudTd> *@
        <MudTd DataLabel="VÉHICULES">
            <MudText Typo="Typo.body2" Style="font-family: 'Inter', sans-serif; font-size: 12px; line-height: 16px; color: #64748B; word-spacing: 0px;">
                @context.drVehic?.Decodvh
                </MudText>
        </MudTd>
        <MudTd DataLabel="STATUT">
            <div class="d-flex align-center gap-1">
                @if (context.drLigne?.Deactif == 0)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    <MudText Typo="Typo.caption" Style="font-family: 'Inter',sans-serif; font-size: 12px;line-height: 16px;color: #2e7d32; font-weight: 500; word-spacing: 0px;">Brouillon</MudText>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Warning" />
                    <MudText Typo="Typo.caption" Style="font-family: 'Inter',sans-serif; font-size: 12px;line-height: 16px;color: #f9a825; font-weight: 500; word-spacing: 0px;">Publié</MudText>
                }
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }"
                       InfoFormat="Affichage {first_item}-{last_item} sur {all_items}"
                       RowsPerPageString="Résultats par page" />
    </PagerContent>
</MudTable>


@code {
    private string _searchBase = "";
    private string _delegation = "Toutes";// Valeur par défaut
    private string _type = "Tous";


    // Liste qui va accueillir les données Délégations
    private List<DrDelegDto> _delegations = new();

    // Liste qui va accueillir les données Délégations
    private List<DrVehiculeDto> _Vehicule = new();

    // Liste qui va accueillir les données Depart et lignes
    private List<DrDepartAllDetailsDto> _Depart = new();


    protected override async Task OnInitializedAsync()
    {
        // Exemple de chargement depuis votre service de base de données
        // Envoi de la requête via MediatR (CQRS)
        var request = new GetListDelegationsRequest();
        var result = await Mediator.Send(request);
        _delegations = result?.Data ?? new List<DrDelegDto>();
        var requestVehicule = new GetListDrVehiculesRequest();
        var resultVehicule = await Mediator.Send(requestVehicule);
        _Vehicule = resultVehicule?.Data ?? new List<DrVehiculeDto>();
        var requestDepart = new GetListDepartAllDetailsRequest();
        var resultDepart = await Mediator.Send(requestDepart);
        _Depart = resultDepart?.Data ?? new List<DrDepartAllDetailsDto>();
    }
    // Cette fonction cherche DYNAMIQUEMENT le Libellé correspondant à l'ID sélectionné
    private string GetDelegationLabel(string value)
    {
        if (value == "Toutes")
            return "Toutes délégations";

        // Recherche l'élément dans la liste de la BDD par son ID
        var delegation = _delegations.FirstOrDefault(d => d.IdDelegation.ToString() == value);

        // Si trouvé, affiche le Nom (Libellé), sinon affiche la valeur brute par sécurité
        return delegation != null ? delegation.NameDelegFr : value;
    }
