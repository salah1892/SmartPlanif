@namespace Dashboard.Components

<MudPaper Elevation="1" Class="pa-3" Style="max-width: 220px;">
    <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Routes</MudText>

    @foreach (var r in _routes)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="my-1">
            @* <MudDivider Vertical="true" Style="width: 20px; border-color: @r.Color; border-width: 3px; border-radius: 2px;" /> *@
            <MudDivider Vertical="true"  />
            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="min-width: 30px;">@r.Id</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@r.Name</MudText>
        </MudStack>
    }

    <MudDivider Class="my-2" />

    <MudStack Spacing="1">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Small" Style="width: 12px; height: 12px; background-color: #27AE60;" />
            <MudText Typo="Typo.caption">Active vehicle</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Small" Style="width: 12px; height: 12px; border-radius: 2px; background-color: #E74C3C;" />
            <MudText Typo="Typo.caption">Breakdown</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudAvatar Size="Size.Small" Style="width: 12px; height: 12px; background-color: transparent; border: 2px solid #2980B9;" />
            <MudText Typo="Typo.caption">Stop</MudText>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private readonly record struct RouteInfo(string Id, string Name, string Color);

    private readonly List<RouteInfo> _routes = new()
    {
        new("42A", "Central Express", "#5B9BD5"),
        new("15B", "Victoria Loop", "#2ECC71"),
        new("88C", "Airport Shuttle", "#9B59B6"),
        new("12U", "University Line", "#F39C12"),
        new("N1", "Night Owl", "#7F8C8D"),
    };
}
