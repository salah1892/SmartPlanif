@using MudBlazor

<MudPaper Class="pa-4 mb-4 d-flex align-center gap-3 flex-wrap" Elevation="0" Outlined="true" Style="border-radius: 8px;">
    <MudTextField @bind-Value="_searchOp" Placeholder="Rechercher par numéro de ligne..."
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 400px;" />

    <MudSelect T="string" Label="Toutes délégations" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 160px;">
        <MudSelectItem Value="@("Toutes")">Toutes délégations</MudSelectItem>
    </MudSelect>

    <MudSelect T="string" Label="Tous types" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 140px;">
        <MudSelectItem Value="@("Tous")">Tous types</MudSelectItem>
    </MudSelect>

    <MudText Typo="Typo.caption" Style="color: #757575;" Class="d-flex align-center gap-1">
        <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" /> 7 / 7 lignes affichées
    </MudText>

    <MudSpacer />

    <div class="d-flex gap-2">
        <MudChip T="string" Size="Size.Small" Style="background-color: #4caf50; color: white;" Variant="Variant.Filled">42A</MudChip>
        <MudChip T="string" Size="Size.Small" Style="background-color: #9c27b0; color: white;" Variant="Variant.Filled">15B</MudChip>
        <MudChip T="string" Size="Size.Small" Style="background-color: #ff9800; color: white;" Variant="Variant.Filled">88C</MudChip>
        <MudChip T="string" Size="Size.Small" Style="background-color: #ffc107; color: black;" Variant="Variant.Filled">12U</MudChip>
        <MudChip T="string" Size="Size.Small" Style="background-color: #37474f; color: white;" Variant="Variant.Filled">N1</MudChip>
        <MudChip T="string" Size="Size.Small" Style="background-color: #e0e0e0; color: #333;" Variant="Variant.Filled">32356</MudChip>
    </div>
</MudPaper>

