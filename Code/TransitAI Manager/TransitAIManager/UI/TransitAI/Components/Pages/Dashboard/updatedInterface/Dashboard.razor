@page "/planification"
@page "/"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4"
              Style="background-color: #f3f4f6;  overflow-x: auto; overflow-y: auto;">

    @* Barre d'onglets personnalisée style "segmented buttons" *@
    <div class="custom-tabs">
        <button class="custom-tab @(_activeTab == 0 ? "active" : "")"
                @onclick="() => _activeTab = 0">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="tab-icon" />
            <span>Planning de Base (Statique)</span>
        </button>

        <button class="custom-tab @(_activeTab == 1 ? "active" : "")"
                @onclick="() => _activeTab = 1">
            <MudIcon Icon="@Icons.Material.Filled.Map" Class="tab-icon" />
            <span>Planning Opérationnel (Dynamique)</span>
        </button>
    </div>

    @* Contenu des panneaux *@
    <div class="mt-3" style="overflow-y: auto;">
        @if (_activeTab == 0)
        {
            <PlanningDeBase />
        }
        else
        {
            <PlanningOperationnel />
        }
    </div>

</MudContainer>

<style>
    .custom-tabs {
        display: inline-flex;
        gap: 8px;
        background-color: transparent;
    }

    .custom-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease-in-out;
        font-family: inherit;
    }

        .custom-tab:hover {
            background-color: #f8fafc;
        }

        .custom-tab .tab-icon {
            font-size: 16px !important;
        }

        /* Onglet actif : fond bleu, texte + icône blancs */
        .custom-tab.active {
            background-color: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
            box-shadow: 0 1px 2px rgba(37, 99, 235, 0.4);
        }

            .custom-tab.active .tab-icon {
                color: #ffffff;
            }
</style>

@code {
    private int _activeTab = 0;
}
