@code {
    [Parameter] public LiveMetrics? Metrics { get; set; }

    private string GetDashArray()
    {
        if (Metrics == null || Metrics.TotalVehicles == 0) return "0 251";
        double ratio = (double)Metrics.ActiveVehicles / Metrics.TotalVehicles;
        double circumference = 2 * Math.PI * 40;
        double active = ratio * circumference;
        return $"{active:F1} {circumference - active:F1}";
    }
}
