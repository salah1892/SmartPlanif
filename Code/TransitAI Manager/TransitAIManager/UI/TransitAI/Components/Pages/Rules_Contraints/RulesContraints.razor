@page "/rules-contraints"
<MudContainer MaxWidth="MaxWidth.False" Class="pa-4"
              Style="background-color: #f3f4f6;  overflow-x: auto; overflow-y: auto;">
              <MudGrid Spacing="4" Style="overflow-y: auto;">
    <MudItem xs="12">
        <MudPaper Class="d-flex align-center pa-2" Elevation="0" Outlined="true" Style="border-radius: 8px; background-color: white;">
            <MudAvatar Rounded="true" Style="width: 36px; height: 36px; background-color: #1976d2; margin-right: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Surface" Size="Size.Medium" />
            </MudAvatar>
            <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: #333;">Profil d’allocation</MudText>
                    <MudText Typo="Typo.caption" Style="color: #757575;">Profil Actif</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    </MudGrid>

</MudContainer>
